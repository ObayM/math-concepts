# Database
DATABASE_URL="postgresql://mathly:mathly@localhost:5432/mathly"

# Docker
POSTGRES_USER=mathly
POSTGRES_PASSWORD=mathly
POSTGRES_DB=mathly

# Better Auth
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# baked into the client bundle at BUILD time, not read at runtime. build with
# the origin you will actually serve on or every login calls the wrong host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# the domain the app is served from, without a scheme. set it and auth accepts
# the apex plus en.<domain> and ar.<domain>, and builds email links against
# whichever one the request came in on. unset falls back to BETTER_AUTH_URL.
APP_DOMAIN=""

# http | https | auto (default). decides which origins auth trusts and whether
# the session cookie is __Secure- prefixed. leave unset behind a tls proxy.
APP_PROTOCOL=""

# set in production so the session cookie is shared across subdomains.
# leave EMPTY in dev: localhost cannot set a shared parent-domain cookie.
COOKIE_DOMAIN=""

# comma separated user ids that are always super_admin regardless of the db
# role. this is the bootstrap path for the first admin on a fresh database.
ADMIN_USER_IDS=""

# how many proxies sit in front of the app. the client ip is read that many
# hops from the right of x-forwarded-for, because anything further left is
# attacker supplied. 0 means the app is exposed directly.
TRUSTED_PROXY_HOPS=1

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key"

# Email. REQUIRED in production: signup needs email verification, so with no
# SMTP_HOST nobody can create an account at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mathly.com

# shared secret for the reminder cron job (POST /api/cron/reminders).
# call it hourly: it only mails users whose local hour is 19.
CRON_SECRET=

# extra origins allowed to call the auth api (tunnels, lan ip). comma separated.
TRUSTED_ORIGINS=""
