{
  "name": "mathly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build:lessons": "node scripts/build-lessons.mjs",
    "build:og": "node scripts/build-og-images.mjs",
    "db:seed": "npm run build:lessons && node prisma/seed.js",
    "prepare": "husky",
    "dsl": "tsx scripts/dsl.ts",
    "test": "vitest run",
    "test:fast": "vitest run --project engine --project dom --project server",
    "test:db:setup": "node --env-file-if-exists=.env scripts/test-db.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postbuild": "node scripts/postbuild-standalone.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.3",
    "@google/genai": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.0.0",
    "ai": "^7.0.8",
    "better-auth": "^1.0.0",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.553.0",
    "monaco-editor": "^0.55.1",
    "next": "16.0.10",
    "nodemailer": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.5",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
