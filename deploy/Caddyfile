{
	email {$ACME_EMAIL}
}

(mathly) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up -X-Real-IP
	}
}

{$APP_DOMAIN} {
	import mathly
}

en.{$APP_DOMAIN} {
	import mathly
}

ar.{$APP_DOMAIN} {
	import mathly
}
