    "quad-vertex",
    "quad-roots",
  ],
  "slides": [
    {
      "category": "Basics",
      "goals": [
        {
          "hint": "The vertex is at the origin.",
          "prompt": "Put the point at the bottom",
          "when": {
            "k": "bin",
            "l": {
              "k": "id",
              "name": "t",
            },
            "op": "==",
            "r": {
              "k": "num",
              "v": 0,
            },
          },
        },
      ],
      "id": "what-is-a-parabola",
      "prose": "A **parabola** is the graph of $y = x^2$ — a U-shaped curve.
Drag the point and watch it ride the curve.",
      "scene": {
        "controls": [
          {
            "as": "slider",
            "bind": "t",
            "label": "move the point",
          },
        ],
        "objects": [
          {
            "color": "primary",
            "expr": {
              "k": "bin",
              "l": {
                "k": "id",
                "name": "x",
              },
