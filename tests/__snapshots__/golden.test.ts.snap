          "type": "plane",
          "xDomain": [
            -4,
            4,
          ],
          "yDomain": [
            -1,
            9,
          ],
        },
        "state": {
          "t": {
            "init": 1,
            "max": 3,
            "min": -3,
            "step": 0.1,
            "type": "number",
          },
        },
        "version": 2,
      },
      "title": "What is a parabola?",
    },
    {
      "category": "Basics",
      "exercise": {
        "correct": 1,
        "explanation": "A negative a flips the U so it opens downward.",
        "hints": [
          "Picture y = -x².",
          "The arms point down.",
        ],
        "kind": "quiz",
        "options": [
          {
            "text": "opens upward",
            "why": "Check the sign — a negative leading term flips it.",
          },
          {
            "text": "opens downward",
          },
          {
            "text": "becomes a line",
            "why": "It still has an x² term, so it stays curved.",
          },
        ],
        "prompt": "If $a < 0$ in $y = ax^2$, the parabola...",
      },
      "id": "which-way-does-it-open",
      "title": "Which way does it open?",
    },
    {
      "category": "Forms",
      "exercise": {
        "answers": [
          [
            "a",
