            "strokeWidth": 3,
            "type": "curve",
          },
          {
            "color": "accent",
            "draggable": {
              "axis": "x",
              "bind": "t",
            },
            "id": "p",
            "label": {
              "parts": [
                "(",
                {
                  "k": "id",
                  "name": "t",
                },
                ", ",
                {
                  "k": "bin",
                  "l": {
                    "k": "id",
                    "name": "t",
                  },
                  "op": "^",
                  "r": {
                    "k": "num",
                    "v": 2,
                  },
                },
                ")",
              ],
            },
            "type": "point",
            "x": {
              "k": "id",
              "name": "t",
            },
            "y": {
              "k": "bin",
              "l": {
                "k": "id",
                "name": "t",
              },
              "op": "^",
              "r": {
                "k": "num",
                "v": 2,
              },
            },
          },
