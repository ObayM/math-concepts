scene plane {
  x: [-5, 5]
  y: [-5, 5]

  let w = 0.45

  def tick(x, len) {
    line f"t{x}" = (x, 0) -> (x, len) { color: neutral }
  }

  tick(1, 0.2)
  tick(2, 0.4)

  for i in range(-4, 5) {
    if i >= 0 {
      rect f"pos{i}" = (i, 0) { w: w, h: i, color: primary }
    } else {
      rect f"neg{i}" = (i, i) { w: w, h: 0 - i, color: neutral }
    }
  }
}
