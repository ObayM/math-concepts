generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean
  image           String?
  username        String?   @unique
  displayUsername String?
  role            String    @default("student")
  reminderEmails  Boolean   @default(true) @map("reminder_emails")
  lastRemindedAt  DateTime? @map("last_reminded_at")
  timezone        String?
  banned          Boolean   @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  sessions        Session[]
  accounts        Account[]
  activities      UserDailyActivity[]
  progress        UserLessonProgress[]
  attempts        LessonAttempt[]
  authoredLessons Lesson[]
  skillMastery    UserSkillMastery[]
  auditEntries    AuditLog[]
  warmupSessions  WarmupSession[]
  warmupAnswers   WarmupAnswer[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum ContentStatus {
  draft
  published
}

model Course {
  id          String        @id @default(uuid())
  name        String        @unique
  slug        String?       @unique
  description String?
  status      ContentStatus @default(published)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  lessons Lesson[]

  @@map("courses")
}

model Lesson {
  id              String        @id @default(uuid())
  courseId        String?       @map("course_id")
  lessonKey       String        @unique @map("lesson_key")
  source          String        @default("")
  data            Json
  publishedSource String?       @map("published_source")
  publishedData   Json?         @map("published_data")
  status          ContentStatus @default(draft)
  authorId        String?       @map("author_id")
  title           String?
  description     String?
  unit            String?
  difficulty      String?
  iconName        String?       @map("icon_name")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  publishedAt     DateTime?     @map("published_at")

  course   Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author   User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  progress UserLessonProgress[]
  attempts LessonAttempt[]

  @@index([courseId])
  @@index([status])
  @@map("lessons")
}

model UserDailyActivity {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  activityDate DateTime @map("activity_date") @db.Date
  xp           Int      @default(0)
  warmupXp     Int      @default(0) @map("warmup_xp")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@map("user_daily_activity")
}

model UserLessonProgress {
  userId       String    @map("user_id")
  lessonId     String    @map("lesson_id")
  completed    Boolean   @default(false)
  completedAt  DateTime? @map("completed_at")
  currentStep  Int       @default(0) @map("current_step")
  lastPlayedAt DateTime  @default(now()) @map("last_played_at")
  quizHistory  Json?     @map("quiz_history")
  xpAwarded    Int       @default(0) @map("xp_awarded")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("user_lesson_progress")
}

model LessonAttempt {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  lessonId     String   @map("lesson_id")
  slideId      String?  @map("slide_id")
  exerciseKind String?  @map("exercise_kind")
  skill        String?  @map("skill")
  question     String
  correct      Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, skill, createdAt])
  @@index([userId, createdAt])
  @@map("lesson_attempts")
}

// an audit row must outlive the thing it describes, so nothing here is a
// foreign key to content and the actor/target labels are snapshots. if this
// row cascaded with the lesson, deleting a lesson would erase the record of
// its own deletion.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  meta        Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

model WarmupSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  level      Int
  seed       String
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  answered   Int       @default(0)
  correct    Int       @default(0)
  bestStreak Int       @default(0) @map("best_streak")
  totalMs    Int       @default(0) @map("total_ms")
  xpAwarded  Int       @default(0) @map("xp_awarded")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers WarmupAnswer[]

  @@index([userId, startedAt])
  @@index([userId, level, startedAt])
  @@map("warmup_sessions")
}

model WarmupAnswer {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  level     Int
  idx       Int
  factKey   String   @map("fact_key")
  prompt    String
  answer    String
  given     String?
  correct   Boolean
  elapsedMs Int      @map("elapsed_ms")
  createdAt DateTime @default(now()) @map("created_at")

  session WarmupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idx])
  @@index([userId, factKey, createdAt])
  @@index([userId, level, createdAt])
  @@map("warmup_answers")
}

model UserSkillMastery {
  userId    String   @map("user_id")
  skill     String
  score     Float    @default(0)
  attempts  Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@index([skill])
  @@map("user_skill_mastery")
}
