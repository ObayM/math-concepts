lesson "النظام الإحداثي المتعامد في ثلاثة أبعاد" {
  course: "solid-geometry-ar"
  unit: "الهندسة والقياس في ثلاثة أبعاد"
  difficulty: "Intermediate"
  icon: "MapPin"
  summary: "كل نقطة في الفراغ ثلاث حركات متعامدة من نقطة الأصل. منها نعيّن النقاط والمستويات، ونحسب الأبعاد بفيثاغورس، ونجد منتصف أي قطعة."
  skills: ["sg-3d-points", "sg-3d-distance", "sg-3d-midpoint"]
  requires: ["sg-2d-coords", "sg-pythagoras"]

  role ground = primary
  role up = success
  role dist = accent

  def box(p, q, r) {
    polygon3 top = [(0, 0, r), (p, 0, r), (p, q, r), (0, q, r)] { color: primary, opacity: 0.1 }
    polygon3 front = [(p, 0, 0), (p, q, 0), (p, q, r), (p, 0, r)] { color: primary, opacity: 0.1 }
    polygon3 side = [(0, q, 0), (p, q, 0), (p, q, r), (0, q, r)] { color: primary, opacity: 0.1 }
  }

  slide "إحماء: نقطة في المستوى" {
    id: "sg1-check-coords"
    beat: check
    cat: "النقطة في الفراغ"
    > إحماء سريع قبل أن نبدأ.

    quiz {
      ask "في المستوى الإحداثي، أين تقع النقطة $(0, -3)$؟"
      skill: "sg-2d-coords"
      - "على محور $x$" { why: "الصفر هنا في الإحداثي $x$، أي أننا لم نتحرك أفقيًا أبدًا. النقاط التي على محور $x$ يكون فيها $y$ هو الصفر.", onwrong: "sg1-bridge-coords", retry }
      - "في الربع الرابع" { why: "الأرباع للنقاط التي لا صفر فيها. هنا $x = 0$، فالنقطة على حدود الأرباع، فوق أحد المحورين.", onwrong: "sg1-bridge-coords", retry }
      * "على محور $y$"
      - "عند نقطة الأصل" { why: "نقطة الأصل هي $(0, 0)$. أما هنا فقد نزلنا $3$ وحدات." }
      hint "الإحداثي الأول يقول كم نتحرك أفقيًا. كم هو هنا؟"
      ! "$x = 0$ يعني أننا لم نتحرك أفقيًا، ثم نزلنا $3$ وحدات، فالنقطة على محور $y$. احفظ هذه الفكرة: الصفر يلصق النقطة بمحور."
    }
  }

  slide "الصفر يلصق النقطة بمحور" {
    id: "sg1-bridge-coords"
    beat: bridge
    hidden: true
    cat: "النقطة في الفراغ"
    > كل إحداثي يقول كم نتحرك في اتجاه واحد. $(0, -3)$: صفر أفقيًا، ثم $3$ للأسفل. لم نغادر محور $y$ أبدًا.

    scene plane {
      alt: "مستوى إحداثي فيه النقطة (0, -3) على محور y تحت نقطة الأصل."
      x: [-4, 4]
      y: [-4, 3]
      aspect: equal
      grid
      point p = (0, -3) { color: accent, label: "(0, -3)" }
      line down = (0, 0) -> (0, -3) { color: accent, style: dashed, width: 3 }
    }

    quiz {
      ask "وأين تقع النقطة $(5, 0)$؟"
      skill: "sg-2d-coords"
      * "على محور $x$"
      - "على محور $y$" { why: "الصفر هنا في $y$: تحركنا $5$ أفقيًا ولم نصعد. فنبقى على المحور الأفقي." }
      - "في الربع الأول" { why: "لا ربع لنقطة فيها صفر. هي على حدود الربعين، فوق محور." }
      ! "$y = 0$: تحركنا أفقيًا فقط، فالنقطة على محور $x$."
    }
  }

  slide "إحماء: فيثاغورس" {
    id: "sg1-check-pyth"
    beat: check
    cat: "النقطة في الفراغ"
    > وسؤال ثانٍ.

    numeric {
      ask "ما البعد بين النقطتين $(2, 1)$ و $(8, 9)$ في المستوى؟"
      skill: "sg-pythagoras"
      answer: 10
      expect: sqrt((8 - 2)^2 + (9 - 1)^2)
      wrong 14 "هذا $6 + 8$. الحركتان متعامدتان، فالبعد وتر مثلث قائم، لا مجموع الضلعين." -> "sg1-bridge-pyth" retry
      wrong 100 "هذا مربع البعد. بقي أن تأخذ الجذر."
      hint "كم نتحرك أفقيًا؟ وكم رأسيًا؟"
      hint "الحركتان ضلعا مثلث قائم، والبعد هو الوتر."
      ! "أفقيًا $6$ ورأسيًا $8$، فالبعد $\sqrt{6^2 + 8^2} = \sqrt{100} = 10$."
    }
  }

  slide "البعد وتر لا مجموع" {
    id: "sg1-bridge-pyth"
    beat: bridge
    hidden: true
    cat: "النقطة في الفراغ"
    > الحركة الأفقية والحركة الرأسية بينهما زاوية قائمة. فالخط المستقيم بين النقطتين هو الوتر، وطوله $\sqrt{a^2 + b^2}$، وهو أقصر دائمًا من $a + b$.

    scene plane {
      alt: "مثلث قائم من (1, 3) إلى (4, 3) إلى (4, 7): ضلع أفقي طوله 3 وضلع رأسي طوله 4 ووتر يصل الطرفين."
      x: [0, 6]
      y: [2, 8]
      aspect: equal
      grid
      line run = (1, 3) -> (4, 3) { color: ground, width: 3 }
      line rise = (4, 3) -> (4, 7) { color: up, width: 3 }
      line hyp = (1, 3) -> (4, 7) { color: dist, width: 3 }
      label at (2.5, 2.5) = "3" { anchor: middle, color: ground }
      label at (4.3, 5) = "4" { color: up }
    }

    numeric {
      ask "ما البعد بين $(1, 3)$ و $(4, 7)$؟"
      skill: "sg-pythagoras"
      answer: 5
      expect: sqrt(3^2 + 4^2)
      wrong 7 "هذا $3 + 4$، طول الطريق على الضلعين. الوتر أقصر."
      ! "$\sqrt{3^2 + 4^2} = \sqrt{25} = 5$. عد الآن إلى سؤال الإحماء."
    }
  }

  slide "درون فوق فناء المدرسة" {
    id: "sg1-hook"
    beat: hook
    cat: "النقطة في الفراغ"
    > درون يقلع من قاعدة سارية العلم في فناء المدرسة. يطير $3$ م في اتجاه، ثم $4$ م في اتجاه عمودي عليه، ثم يرتفع $12$ م لأعلى.

    scene space3 {
      alt: "مسار الدرون: خطان على الأرض طولهما 3 ثم 4 بزاوية قائمة، ثم خط رأسي طوله 12 ينتهي عند الدرون. لا خط مستقيم مرسوم بين البداية والدرون. مؤشر يلفّ المشهد."
      x: [0, 5]
      y: [0, 5]
      z: [0, 13]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 18]
      segment3 m1 = (0, 0, 0) -> (3, 0, 0) { color: ground, width: 3 }
      segment3 m2 = (3, 0, 0) -> (3, 4, 0) { color: ground, width: 3 }
      segment3 m3 = (3, 4, 0) -> (3, 4, 12) { color: up, width: 3 }
      point3 drone = (3, 4, 12) { color: warning, r: 7 }
      point3 start = (0, 0, 0) { color: neutral, label: "O" }
      slider az { label: "لفّ المشهد" }
    }

    quiz {
      ask "كم يبعد الدرون الآن عن نقطة إقلاعه، في خط مستقيم؟"
      skill: "sg-3d-distance"
      - "$19$ م" { why: "هذا طول الطريق كله. لكن الخط المستقيم يختصر. بعد شريحتين سترى كم يختصر." }
      - "$17$ م" { why: "أنت قريب من شيء مهم في الجزء الأرضي. تابع شريحتين وسترى هل يُجمع الارتفاع هكذا." }
      * "$13$ م"
      - "$12$ م" { why: "الارتفاع جزء من الحكاية، لكن الدرون تحرك جانبيًا أيضًا. تابع وسترى كيف يجتمع الاثنان." }
      ! "هذا رهان الآن. الشريحتان القادمتان تحسمانه."
    }
  }

  slide "ثلاث حركات" {
    id: "sg1-fly"
    beat: explore
    cat: "النقطة في الفراغ"
    > على اليسار الدرون في الفراغ، وعلى اليمين خريطة الفناء من فوق. طيّره في مسار السؤال، وراقب ما تعرفه الخريطة وما لا تعرفه.

    scene space3 {
      alt: "الدرون في الفراغ مع مساره: حركة على محور x ثم حركة موازية لمحور y ثم صعود. ثلاثة مؤشرات تحرك كل واحد منها في اتجاه، ومؤشر رابع يلفّ المشهد."
      x: [0, 5]
      y: [0, 5]
      z: [0, 13]
      param a = 0 { range: [0, 5], step: 1 }
      param b = 0 { range: [0, 5], step: 1 }
      param c = 0 { range: [0, 13], step: 1 }
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 18]
      segment3 m1 = (0, 0, 0) -> (a, 0, 0) { color: ground, width: 3 }
      segment3 m2 = (a, 0, 0) -> (a, b, 0) { color: ground, width: 3 }
      segment3 m3 = (a, b, 0) -> (a, b, c) { color: up, width: 3 }
      point3 drone = (a, b, c) { color: warning, r: 7 }
      slider a { label: "الحركة الأولى" }
      slider b { label: "الحركة الثانية" }
      slider c { label: "الارتفاع" }
      slider az { label: "لفّ المشهد" }
    }

    scene plane {
      alt: "خريطة الفناء من فوق: نقطة الدرون تتحرك مع الحركتين الأولى والثانية فقط، ولا تتغير حين يرتفع."
      x: [-0.5, 5.5]
      y: [-0.5, 5.5]
      aspect: equal
      grid
      line g1 = (0, 0) -> (a, 0) { color: ground, width: 3 }
      line g2 = (a, 0) -> (a, b) { color: ground, width: 3 }
      point shadow = (a, b) { color: warning }
    }

    goal "طيّر الدرون في مسار السؤال: $3$ ثم $4$ ثم $12$ لأعلى" {
      when: a == 3 and b == 4 and c == 12
      hints: ["كل مؤشر يحرك الدرون في اتجاه واحد فقط. أيها يرفعه؟", "الحركة الأولى $3$، والثانية $4$، والارتفاع $12$."]
      showme: { a: 3, b: 4, c: 12 }
      dur: 2500
    }

    quiz {
      ask "صديقك يطير درونًا آخر: $4$ في الاتجاه الأول، ثم $3$ في الثاني، ثم $12$ لأعلى. هل يصل إلى المكان نفسه؟"
      skill: "sg-3d-points"
      - "نعم، الأعداد هي نفسها" { why: "الأعداد نفسها لكن كل عدد في اتجاه مختلف. جرّبها على الخريطة: $(4, 3)$ ليست $(3, 4)$.", onwrong: "sg1-d-order", retry }
      * "لا، لأن كل عدد يخص اتجاهًا بعينه"
      - "نعم، لأن الارتفاع نفسه" { why: "الارتفاع نفسه، لكن النقطة التي تحته على الأرض مختلفة.", onwrong: "sg1-d-order", retry }
      - "لا، لأنه صار أبعد عن نقطة الإقلاع" { why: "بعده عن نقطة الإقلاع هو نفسه في الحالتين، وستحسبه بعد قليل. الاختلاف في المكان لا في البعد." }
      after: goals
      ! "الخريطة تعرف عددين فقط، والارتفاع يحتاج ثالثًا. والترتيب هو المعنى: الأول للاتجاه الأول، والثاني للثاني، والثالث للارتفاع. لذلك نكتب النقطة ثلاثيًا **مرتبًا**."
    }
  }

  slide "الترتيب يغيّر المكان" {
    id: "sg1-d-order"
    beat: detour
    hidden: true
    cat: "النقطة في الفراغ"
    > كل موضع في الثلاثي يخص اتجاهًا. تبديل عددين يعني المشي في اتجاه آخر. هنا الدرونان: $(3, 4, 12)$ و $(4, 3, 12)$. لفّ المشهد وقارن.

    scene space3 {
      alt: "درونان على الارتفاع نفسه، أحدهما فوق (3, 4) والآخر فوق (4, 3)، مع خطوط منقطة إلى الأرض."
      x: [0, 5]
      y: [0, 5]
      z: [0, 13]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 18]
      point3 d1 = (3, 4, 12) { color: warning, guides, label: "(3, 4, 12)" }
      point3 d2 = (4, 3, 12) { color: primary, guides, label: "(4, 3, 12)" }
      slider az { label: "لفّ المشهد" }
    }

    quiz {
      ask "هل النقطة $(2, 5, 1)$ هي النقطة $(5, 2, 1)$؟"
      skill: "sg-3d-points"
      - "نعم، الأعداد نفسها" { why: "انظر إلى الدرونين: الأعداد نفسها والمكانان مختلفان." }
      * "لا، الترتيب مختلف فالمكان مختلف"
      ! "الأولى تمشي $2$ ثم $5$، والثانية $5$ ثم $2$. مكانان مختلفان على الارتفاع نفسه."
    }
  }

  slide "فيثاغورس مرتين" {
    id: "sg1-reveal"
    beat: reveal
    cat: "النقطة في الفراغ"
    > رهانك كان ${answer("sg1-hook", "رهانًا")}. الحركتان على الأرض تنتهيان عند $F$، تحت الدرون $P$ مباشرة. لفّ المشهد حتى تواجه المثلث $OFP$ وترى زاويته عند $F$.

    scene space3 {
      alt: "الدرون P فوق النقطة F على الأرض. خط أرضي من O إلى F، وخط رأسي من F إلى P طوله 12، وخط مستقيم من O إلى P. مؤشر يلفّ المشهد."
      x: [0, 5]
      y: [0, 5]
      z: [0, 13]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 12]
      segment3 m1 = (0, 0, 0) -> (3, 0, 0) { color: ground, style: dashed }
      segment3 m2 = (3, 0, 0) -> (3, 4, 0) { color: ground, style: dashed }
      segment3 of = (0, 0, 0) -> (3, 4, 0) { color: ground, width: 3 }
      segment3 fp = (3, 4, 0) -> (3, 4, 12) { color: up, width: 3, label: "12" }
      segment3 op = (0, 0, 0) -> (3, 4, 12) { color: dist, width: 3 }
      point3 drone = (3, 4, 12) { color: warning, r: 7, label: "P" }
      point3 foot = (3, 4, 0) { color: ground, label: "F" }
      point3 start = (0, 0, 0) { color: neutral, label: "O" }
      label3 at (1.5, -0.6, 0) = "3" { color: ground }
      label3 at (3.6, 2, 0) = "4" { color: ground }
      slider az { label: "لفّ المشهد" }
    }

    goal "لفّ المشهد حتى تواجه المثلث $OFP$" {
      when: (az >= 130 and az <= 155) or (az >= 310 and az <= 335)
      hints: ["المثلث $OFP$ واقف كالحائط. لفّ حتى تنظر إليه من الأمام.", "حين تواجهه تمامًا يبدو $OF$ أفقيًا و $FP$ رأسيًا."]
      showme: { az: 145 }
    }

    numeric {
      ask "كم يبعد الدرون $P$ عن نقطة الإقلاع $O$؟"
      skill: "sg-3d-distance"
      answer: 13
      expect: sqrt(sqrt(3^2 + 4^2)^2 + 12^2)
      unit: "م"
      wrong 19 "هذا طول الطريق $3 + 4 + 12$. الخط المستقيم يختصره." -> "sg1-d-add" retry
      wrong 17 "الجزء الأرضي $5$ صحيح. لكن $5$ و $12$ ضلعان متعامدان أيضًا، فلا يُجمعان." -> "sg1-d-add" retry
      wrong 5 "هذا $OF$ على الأرض فقط. بقي الارتفاع."
      wrong 12 "هذا $FP$ وحده. الدرون تحرك جانبيًا أيضًا."
      hint "ابدأ بـ $OF$: ضلعاه على الأرض $3$ و $4$."
      hint "ثم المثلث $OFP$ قائم في $F$."
      after: goals
      ! "على الأرض: $OF = \sqrt{3^2 + 4^2} = 5$. والارتفاع عمودي على الأرض، فالمثلث $OFP$ قائم في $F$: $OP = \sqrt{5^2 + 12^2} = 13$. فيثاغورس مرتين."
    }
  }

  slide "الحركات المتعامدة لا تُجمع" {
    id: "sg1-d-add"
    beat: detour
    hidden: true
    cat: "النقطة في الفراغ"
    > جمع الحركات يعطي طول **الطريق**. الخط المستقيم أقصر، لأن كل حركة عمودية على ما قبلها: ضلع قائم في مثلث، والبعد وتره. درون جديد: $2$ ثم $3$ ثم $6$ لأعلى.

    scene space3 {
      alt: "مسار درون: 2 ثم 3 على الأرض ثم 6 لأعلى، مع الخط الأرضي من البداية إلى النقطة تحته، والخط المستقيم إلى الدرون."
      x: [0, 4]
      y: [0, 4]
      z: [0, 7]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 15]
      segment3 m1 = (0, 0, 0) -> (2, 0, 0) { color: ground, style: dashed }
      segment3 m2 = (2, 0, 0) -> (2, 3, 0) { color: ground, style: dashed }
      segment3 of = (0, 0, 0) -> (2, 3, 0) { color: ground, width: 3 }
      segment3 fp = (2, 3, 0) -> (2, 3, 6) { color: up, width: 3 }
      segment3 op = (0, 0, 0) -> (2, 3, 6) { color: dist, width: 3 }
      point3 drone = (2, 3, 6) { color: warning, r: 7 }
      slider az { label: "لفّ المشهد" }
    }

    numeric {
      ask "كم يبعد هذا الدرون عن نقطة إقلاعه؟"
      skill: "sg-3d-distance"
      answer: 7
      expect: sqrt(2^2 + 3^2 + 6^2)
      unit: "م"
      wrong 11 "هذا طول الطريق من جديد. خذ الوتر مرتين."
      wrong sqrt(13) + 6 "$\sqrt{13}$ على الأرض صحيح، لكنه عمودي على الارتفاع $6$، فلا يُجمع معه."
      hint "على الأرض: $\sqrt{2^2 + 3^2}$. ثم وتر ثانٍ مع الارتفاع."
      ! "$\sqrt{2^2 + 3^2} = \sqrt{13}$ على الأرض، ثم $\sqrt{13 + 36} = \sqrt{49} = 7$."
    }
  }

  slide "أسماء لما فعلته" {
    id: "sg1-name"
    beat: name
    cat: "النقطة في الفراغ"
    > حركاتك الثلاث لها أسماء. المحاور $x$ و $y$ و $z$ تتقاطع في **نقطة الأصل** $O$، وكل محورين متعامدان. قاعدة اليد اليمنى: السبابة نحو $x$، والوسطى نحو $y$، والإبهام نحو $z$.

    scene space3 {
      alt: "مسار الدرون من O إلى P(3, 4, 12) مع خطوط منقطة إلى المحاور. خطوتان: الكلمات الحركة الأولى والثانية والارتفاع تتحول إلى x = 3 و y = 4 و z = 12."
      x: [0, 5]
      y: [0, 5]
      z: [0, 13]
      param az = 55 { range: [0, 360], step: 5 }
      param m = 0 { range: [0, 1] }
      camera: [az, 18]
      segment3 m1 = (0, 0, 0) -> (3, 0, 0) { color: ground, width: 3 }
      segment3 m2 = (3, 0, 0) -> (3, 4, 0) { color: ground, width: 3 }
      segment3 m3 = (3, 4, 0) -> (3, 4, 12) { color: up, width: 3 }
      point3 drone = (3, 4, 12) { color: warning, r: 7, guides }
      label3 w1 at (1.5, -1, 0) = "الحركة الأولى" { color: ground }
      label3 s1 at (1.5, -1, 0) = "x = 3" { color: ground }
      label3 w2 at (3.8, 2, 0) = "الحركة الثانية" { color: ground }
      label3 s2 at (3.8, 2, 0) = "y = 4" { color: ground }
      label3 w3 at (3.6, 4.6, 6) = "الارتفاع" { color: up }
      label3 s3 at (3.6, 4.6, 6) = "z = 12" { color: up }
      label3 w4 at (3, 4, 13) = "الدرون" { color: warning }
      label3 s4 at (3, 4, 13) = "P(3, 4, 12)" { color: warning }
      morph w1 -> s1 { by: m }
      morph w2 -> s2 { by: m }
      morph w3 -> s3 { by: m }
      morph w4 -> s4 { by: m }
      slider az { label: "لفّ المشهد" }
      step "بكلماتك: حركة أولى، ثم ثانية، ثم ارتفاع." { set: { m: 0 } }
      step "وبالرموز: الدرون هو النقطة P(3, 4, 12)، ثلاثي مرتب." { animate: { m: 1 }, dur: 1200, indicate: ["m1", "m2", "m3"] }
    }

    quiz {
      ask "النقاط $L$ و $M$ و $N$ هي مساقط النقطة $A(3, 4, 5)$ على المحاور $x$ و $y$ و $z$ بالترتيب. ما $M$؟"
      skill: "sg-3d-points"
      - "$(3, 0, 5)$" { why: "هذه نقطة في المستوى $xz$، لا على محور. المسقط على محور $y$ يبقي $y$ وحده." }
      * "$(0, 4, 0)$"
      - "$(0, 4, 5)$" { why: "هذا مسقطها على المستوى $yz$. على المحور نفسه يبقى إحداثي واحد فقط." }
      - "$(0, -4, 0)$" { why: "الإسقاط لا يغيّر الإشارة. هو نزول عمودي فقط." }
      hint "انظر إلى الخطوط المنقطة من الدرون: أين تلمس محور $y$؟"
      after: 2
      ! "نقاط محور $y$ كلها على الصورة $(0, y, 0)$. المسقط يبقي $y = 4$ ويصفّر الباقي. وبالمثل $L(3, 0, 0)$ و $N(0, 0, 5)$."
    }
  }

  slide "عيّن النقطة" {
    id: "sg1-plot"
    beat: example
    cat: "النقطة في الفراغ"
    > الكتاب يكتب المحاور $x$ و $y$ و $z$ بالحروف س و ص و ع، والمعنى واحد. طريقته لتعيين نقطة: امشِ $x$، ثم $y$، ثم اصعد $z$. العدد السالب يعني أن تمشي في الاتجاه المعاكس، أو تنزل تحت الأرض.

    scene space3 {
      alt: "محاور ثلاثية من -5 إلى 5 ونقطة يصلها مسار من ثلاث حركات. ثلاثة مؤشرات للإحداثيات ومؤشر يلفّ المشهد."
      x: [-5, 5]
      y: [-5, 5]
      z: [-5, 5]
      param a = 0 { range: [-5, 5], step: 1 }
      param b = 0 { range: [-5, 5], step: 1 }
      param c = 0 { range: [-5, 5], step: 1 }
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      segment3 m1 = (0, 0, 0) -> (a, 0, 0) { color: ground, width: 3 }
      segment3 m2 = (a, 0, 0) -> (a, b, 0) { color: ground, width: 3 }
      segment3 m3 = (a, b, 0) -> (a, b, c) { color: up, width: 3 }
      point3 p = (a, b, c) { color: warning, r: 6, label: "(${a}, ${b}, ${c})" }
      slider a { label: "x" }
      slider b { label: "y" }
      slider c { label: "z" }
      slider az { label: "لفّ المشهد" }
    }

    goal "عيّن النقطة $A(3, 2, 3)$" {
      when: a == 3 and b == 2 and c == 3
      hints: ["ابدأ بالمؤشر $x$، ثم $y$، ثم $z$.", "$3$ على محور $x$، ثم $2$ موازيًا لمحور $y$، ثم اصعد $3$."]
      showme: { a: 3, b: 2, c: 3 }
    }

    goal "ثم عيّن النقطة $B(-4, 4, -2)$" {
      when: a == -4 and b == 4 and c == -2
      hints: ["$-4$ يعني أن تمشي على محور $x$ في الاتجاه السالب.", "و $-2$ في الآخر يعني أن تنزل وحدتين تحت الأرض."]
      showme: { a: -4, b: 4, c: -2 }
    }
  }

  slide "عيّن بنفسك" {
    id: "sg1-plot-own"
    beat: example
    cat: "النقطة في الفراغ"
    > من تمارين الكتاب. عيّن النقطتين، ثم فكّر في نقطة ثالثة.

    scene space3 {
      alt: "محاور ثلاثية من -5 إلى 5 ونقطة يصلها مسار من ثلاث حركات. ثلاثة مؤشرات للإحداثيات ومؤشر يلفّ المشهد."
      x: [-5, 5]
      y: [-5, 5]
      z: [-5, 5]
      param a = 0 { range: [-5, 5], step: 1 }
      param b = 0 { range: [-5, 5], step: 1 }
      param c = 0 { range: [-5, 5], step: 1 }
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      segment3 m1 = (0, 0, 0) -> (a, 0, 0) { color: ground, width: 3 }
      segment3 m2 = (a, 0, 0) -> (a, b, 0) { color: ground, width: 3 }
      segment3 m3 = (a, b, 0) -> (a, b, c) { color: up, width: 3 }
      point3 p = (a, b, c) { color: warning, r: 6, label: "(${a}, ${b}, ${c})" }
      slider a { label: "x" }
      slider b { label: "y" }
      slider c { label: "z" }
      slider az { label: "لفّ المشهد" }
    }

    goal "عيّن النقطة $A(3, 4, 5)$" {
      when: a == 3 and b == 4 and c == 5
      hints: ["$x$ ثم $y$ ثم $z$، بالترتيب."]
      showme: { a: 3, b: 4, c: 5 }
    }

    goal "ثم عيّن النقطة $B(-3, 2, 5)$" {
      when: a == -3 and b == 2 and c == 5
      hints: ["$-3$ على محور $x$ في الاتجاه السالب، والباقي كالمعتاد."]
      showme: { a: -3, b: 2, c: 5 }
    }

    quiz {
      ask "الآن $C(-2, 4, 0)$، من أمثلة الكتاب. أين تنتهي رحلتك؟"
      skill: "sg-3d-points"
      - "على محور $y$" { why: "للوصول إلى محور $y$ يجب أن يكون $x = 0$ و $z = 0$. هنا $x = -2$.", onwrong: "sg1-d-plane", retry }
      * "في المستوى $xy$، على الأرض"
      - "تحت المستوى $xy$" { why: "$z = 0$ يعني ألا تصعد ولا تنزل أبدًا، فتبقى على الأرض تمامًا." }
      - "في المستوى $yz$" { why: "نقاط المستوى $yz$ فيها $x = 0$. هنا الصفر في $z$.", onwrong: "sg1-d-plane", retry }
      after: goals
      ! "$z = 0$: لا صعود ولا نزول، فتبقى $C$ على الأرض، أي في المستوى $xy$."
    }
  }

  slide "أي إحداثي يساوي صفرًا؟" {
    id: "sg1-d-plane"
    beat: detour
    hidden: true
    cat: "المستويات والمحاور"
    > اسم المستوى يذكر الإحداثيين الحرّين. الثالث، الغائب عن الاسم، هو الصفر: في $xy$ يكون $z = 0$، وفي $xz$ يكون $y = 0$، وفي $yz$ يكون $x = 0$. والمحور يصفّر الاثنين الآخرين.

    scene space3 {
      alt: "المستويات الإحداثية الثلاثة: الأرض xy وجداران xz و yz، كل منها مكتوب عليه اسمه."
      x: [0, 5]
      y: [0, 5]
      z: [0, 5]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      plane3 pxy { normal: (0, 0, 1), through: (2.5, 2.5, 0), size: 2.5, color: neutral, opacity: 0.1 }
      plane3 pxz { normal: (0, 1, 0), through: (2.5, 0, 2.5), size: 2.5, color: accent, opacity: 0.15 }
      plane3 pyz { normal: (1, 0, 0), through: (0, 2.5, 2.5), size: 2.5, color: primary, opacity: 0.1 }
      label3 at (3, 3, 0.3) = "xy: z = 0" { color: neutral }
      label3 at (3, 0, 4) = "xz: y = 0" { color: accent }
      label3 at (0, 3, 4) = "yz: x = 0" { color: primary }
      slider az { label: "لفّ المشهد" }
    }

    numeric {
      ask "النقطة $A(4 + k, k - 2, 2k)$ تقع في المستوى $yz$. ما $k$؟"
      skill: "sg-3d-points"
      answer: -4
      expect: 0 - 4
      wrong 2 "هذا تصفير $y$، وهو شرط المستوى $xz$. المستوى $yz$ يصفّر $x$."
      wrong 0 "هذا تصفير $z$، وهو شرط الأرض $xy$. المستوى $yz$ يصفّر $x$."
      ! "في $yz$ يكون $x = 0$: $4 + k = 0$ فـ $k = -4$، والنقطة $(0, -6, -8)$."
    }
  }

  slide "الجدران والأرض" {
    id: "sg1-planes"
    beat: explore
    cat: "المستويات والمحاور"
    > كل محورين يحدّدان مستوى: $xy$ هو الأرض، و $xz$ و $yz$ جداران. النقطة الآن في الهواء. أدخلها في الجدار $xz$ المظلل.

    scene space3 {
      alt: "المستويات الإحداثية الثلاثة، والجدار xz مظلل. نقطة في الهواء مع خطوط منقطة، وثلاثة مؤشرات لإحداثياتها ومؤشر يلفّ المشهد."
      x: [0, 5]
      y: [0, 5]
      z: [0, 5]
      param a = 2 { range: [0, 5], step: 1 }
      param b = 3 { range: [0, 5], step: 1 }
      param c = 2 { range: [0, 5], step: 1 }
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      plane3 pxy { normal: (0, 0, 1), through: (2.5, 2.5, 0), size: 2.5, color: neutral, opacity: 0.06 }
      plane3 pxz { normal: (0, 1, 0), through: (2.5, 0, 2.5), size: 2.5, color: accent, opacity: 0.18 }
      plane3 pyz { normal: (1, 0, 0), through: (0, 2.5, 2.5), size: 2.5, color: neutral, opacity: 0.06 }
      label3 at (4, 0, 4.6) = "xz" { color: accent }
      label3 at (4, 4, 0.3) = "xy" { color: neutral }
      label3 at (0, 4, 4.6) = "yz" { color: neutral }
      point3 p = (a, b, c) { color: warning, r: 6, guides, label: "(${a}, ${b}, ${c})" }
      slider a { label: "x" }
      slider b { label: "y" }
      slider c { label: "z" }
      slider az { label: "لفّ المشهد" }
    }

    goal "أدخل النقطة في الجدار $xz$، لا على أحد محوريه" {
      when: b == 0 and a > 0 and c > 0
      hints: ["جرّب كل مؤشر وحده، وراقب أيها يقرّب النقطة من الجدار المظلل.", "الجدار $xz$ يمر بمحوري $x$ و $z$. أي إحداثي يبعدك عنه؟"]
      showme: { b: 0 }
    }

    quiz {
      ask "إذا كانت النقطة $(x, y, z)$ تقع في المستوى الإحداثي $xz$ فإن:"
      skill: "sg-3d-points"
      - "$x = 0$" { why: "$x = 0$ هو الجدار الآخر، $yz$.", onwrong: "sg1-d-plane", retry }
      * "$y = 0$"
      - "$z = 0$" { why: "$z = 0$ هو الأرض، المستوى $xy$.", onwrong: "sg1-d-plane", retry }
      - "$x + y = 0$" { why: "هذا مستوى مائل يمر بمحور $z$ وحده، وليس مستوى إحداثيًا." }
      after: goals
      ! "داخل الجدار $xz$ تتحرك بحرية في $x$ و $z$، أما $y$ فصفر. لذلك معادلة $xz$ هي $y = 0$، ومعادلة $xy$ هي $z = 0$، ومعادلة $yz$ هي $x = 0$."
    }
  }

  slide "أين تقع كل نقطة؟" {
    id: "sg1-sort"
    beat: example
    cat: "المستويات والمحاور"
    > بلا رسم هذه المرة: الأصفار وحدها تكفي.

    sort {
      ask "ضع كل نقطة في أدق مكان لها. النقطة التي على محور تقع في مستويين، فضعها في «على محور»."
      skill: "sg-3d-points"
      bin "المستوى $xy$": ["$(2, -3, 0)$", "$(-1, 5, 0)$"]
      bin "المستوى $xz$": ["$(2, 0, -3)$", "$(5, 0, 3)$"]
      bin "المستوى $yz$": ["$(0, 4, 5)$", "$(0, -1, 6)$"]
      bin "على محور": ["$(2, 0, 0)$", "$(0, 0, 7)$"]
      hint "ابحث عن الصفر أولًا. كم صفرًا في النقطة؟"
      hint "صفر واحد: مستوى اسمه الحرفان الآخران. صفران: محور."
      ! "صفر واحد يضعك في مستوى: $(2, 0, -3)$ فيها $y = 0$ فهي في $xz$. صفران يضعانك على محور: $(2, 0, 0)$ على محور $x$."
    }
  }

  slide "حيث تلتقي المستويات" {
    id: "sg1-planes-match"
    beat: example
    cat: "المستويات والمحاور"
    > كل مستويين إحداثيين يلتقيان في المحور المشترك بين اسميهما.

    match {
      ask "صِل كل جملة بما يكملها."
      skill: "sg-3d-points"
      pair "المستويان $xy$ و $yz$ يتقاطعان في" -> "محور $y$"
      pair "المستويات الثلاثة $xy$ و $xz$ و $yz$ تتقاطع معًا في" -> "نقطة الأصل"
      pair "المستقيمان $\overleftrightarrow{xx'}$ و $\overleftrightarrow{zz'}$ يكوّنان المستوى" -> "$y = 0$"
      pair "معادلة محور $z$ في الفراغ" -> "$x = 0$ و $y = 0$"
      decoy "محور $x$"
      decoy "$z = 0$"
      decoy "$x = 0$ و $z = 0$"
      miss "المستويان $xy$ و $yz$ يتقاطعان في" -> "محور $x$" "محور $x$ ليس في المستوى $yz$، ففيه $x = 0$. المحور المشترك هو الحرف الموجود في الاسمين: $y$."
      miss "المستقيمان $\overleftrightarrow{xx'}$ و $\overleftrightarrow{zz'}$ يكوّنان المستوى" -> "$z = 0$" "المستقيمان هما محورا $x$ و $z$، فالمستوى $xz$، وفيه $y = 0$."
      miss "معادلة محور $z$ في الفراغ" -> "$x = 0$ و $z = 0$" "على محور $z$ يكون $z$ حرًّا. الصفران هما $x$ و $y$."
      hint "المحور المشترك بين مستويين هو الحرف الذي يظهر في اسميهما."
      ! "$xy$ و $yz$ يشتركان في $y$، والثلاثة تشترك في $O$ وحدها. ومحور $z$ يصفّر الاثنين الآخرين: $x = 0$ و $y = 0$."
    }
  }

  slide "مستويات توازي الأرض والجدران" {
    id: "sg1-parallel"
    beat: example
    cat: "المستويات والمحاور"
    > المستوى لا يلزم أن يمر بنقطة الأصل. كل النقاط $(x, y, 2)$ ترتفع $2$ فوق الأرض مهما كان $x$ و $y$: أرضية ثانية توازي $xy$.

    quiz {
      ask "جميع نقاط الفراغ التي على الصورة $(x, 5, z)$ تقع في المستوى الذي معادلته:"
      skill: "sg-3d-points"
      - "$x = 5$" { why: "هنا $x$ حرّ يأخذ أي قيمة. الثابت هو الإحداثي الأوسط، $y$." }
      * "$y = 5$"
      - "$z = 0$" { why: "$z$ هنا حرّ أيضًا. الثابت هو $y$." }
      - "$y = 0$" { why: "$y = 0$ هو الجدار $xz$ نفسه. نقاطك تبعد عنه $5$، في جدار يوازيه." }
      ! "الإحداثي الثابت هو $y = 5$، فالنقاط في مستوى يوازي الجدار $xz$ ويبعد عنه $5$. معادلته $y = 5$."
    }
  }

  slide "الإسقاط على مستوى" {
    id: "sg1-proj-plane"
    beat: example
    cat: "المستويات والمحاور"
    > مسقط نقطة على مستوى: انزل منها عموديًا حتى تلمسه، مثل ظل الدرون على الأرض عند الظهر.

    quiz {
      ask "النقاط $L$ و $M$ و $N$ هي مساقط $A(3, 4, 5)$ على المستويات $xy$ و $yz$ و $xz$ بالترتيب. ما $L$؟"
      skill: "sg-3d-points"
      - "$(-3, -4, 0)$" { why: "الإسقاط لا يقلب الإشارات. الظل يقع تحت النقطة مباشرة." }
      - "$(0, 4, 5)$" { why: "هذا $M$، مسقطها على الجدار $yz$." }
      * "$(3, 4, 0)$"
      - "$(3, 0, 0)$" { why: "هذه على محور $x$. المستوى يبقي إحداثيين لا واحدًا." }
      ! "الإسقاط على الأرض $xy$ يبقي $x$ و $y$ ويصفّر $z$: $L(3, 4, 0)$."
    }
  }

  slide "البعد عن مستوى" {
    id: "sg1-dist-plane"
    beat: example
    cat: "البعد عن المستويات والمحاور"
    > الدرون على ارتفاع $12$، فهو يبعد $12$ عن الأرض، أي عن المستوى $xy$. وارتفاعه هو إحداثيه $z$. فأي إحداثي يقيس البعد عن الجدار $xz$؟

    quiz {
      ask "بُعد النقطة $A(2, -3, 5)$ عن المستوى الإحداثي $xz$ يساوي … وحدة طول."
      skill: "sg-3d-points"
      - "$2$" { why: "$2$ هو $x$، وهو البعد عن الجدار الآخر $yz$." }
      - "$-3$" { why: "البعد لا يكون سالبًا. الإشارة تقول في أي جهة من الجدار تقع النقطة، والبعد $|-3|$." }
      * "$3$"
      - "$5$" { why: "$5$ هو $z$، أي البعد عن الأرض $xy$." }
      ! "وحده $y$ يبعدك عن الجدار $xz$، فالبعد $|y| = |-3| = 3$. وبالمثل البعد عن $yz$ هو $|x|$، وعن $xy$ هو $|z|$."
    }
  }

  slide "ثلاثة أبعاد معًا" {
    id: "sg1-planes-sum"
    beat: example
    cat: "البعد عن المستويات والمحاور"
    > جرّبها أنت الآن.

    numeric {
      ask "النقطة $A(3, -5, 1)$ في الفراغ. مجموع أبعادها عن المستويات الإحداثية الثلاثة = ؟"
      skill: "sg-3d-points"
      answer: 9
      expect: abs(3) + abs(-5) + abs(1)
      unit: "وحدة طول"
      wrong -1 "هذا مجموع الإحداثيات بإشاراتها. البعد لا يكون سالبًا، فخذ القيم المطلقة."
      wrong 35 "هذا مجموع المربعات. البعد عن مستوى إحداثي هو إحداثي واحد، بلا تربيع."
      wrong sqrt(35) "هذا بعدها عن نقطة الأصل، لا عن المستويات."
      hint "كل مستوى يقيسه إحداثي واحد، بقيمته المطلقة."
      ! "$|3| + |-5| + |1| = 3 + 5 + 1 = 9$."
    }
  }

  slide "ابدأ بشرط المستوى" {
    id: "sg1-planes-17"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    numeric {
      ask "النقطة $(2a, a + 3, 5)$ تقع في المستوى الإحداثي $xz$. كم تبعد عن المستوى الإحداثي $yz$؟"
      skill: "sg-3d-points"
      answer: 6
      expect: abs(2 * (0 - 3))
      unit: "وحدة طول"
      wrong 5 "$5$ هو $|z|$، البعد عن الأرض $xy$. المطلوب البعد عن $yz$."
      wrong -6 "البعد لا يكون سالبًا: خذ $|x|$."
      wrong 3 "هذا $|a|$. لكن $x = 2a$."
      hint "أولًا: في $xz$ يكون $y = 0$. ماذا يعطيك ذلك عن $a$؟"
      ! "$a + 3 = 0$ فـ $a = -3$ والنقطة $(-6, 0, 5)$. البعد عن $yz$ هو $|x| = 6$."
    }
  }

  slide "شرطان معًا" {
    id: "sg1-planes-18"
    beat: breaker
    cat: "البعد عن المستويات والمحاور"

    numeric {
      ask "النقطة $(a - 2, 5, a - 4)$ تبعد خمس وحدات عن المستوى $yz$، وثلاث وحدات عن المستوى $xy$. ما $a$؟"
      skill: "sg-3d-points"
      answer: 7
      expect: 2 + 5
      wrong -3 "$a = -3$ يجعل $|x| = 5$، لكن $|z| = |-7| = 7$ لا $3$. يجب أن يتحقق الشرطان معًا."
      wrong 1 "$a = 1$ يجعل $|z| = 3$، لكن $|x| = 1$ لا $5$."
      hint "$|a - 2| = 5$ له حلان، وكذلك $|a - 4| = 3$."
      hint "أي قيمة تظهر في الحلين؟"
      ! "$|a - 2| = 5$ يعطي $7$ أو $-3$، و $|a - 4| = 3$ يعطي $7$ أو $1$. المشترك $a = 7$."
    }
  }

  slide "والبعد عن محور؟" {
    id: "sg1-trap"
    beat: trap
    cat: "البعد عن المستويات والمحاور"
    > الدرون يبعد $12$ عن الأرض، و $12$ هو $z$. إذن يبعد $3$ عن محور $x$ لأن $3$ هو $x$، صحيح؟ حرّك $Q$ على محور $x$ وابحث عن أقرب نقطة إلى الدرون.

    scene space3 {
      alt: "الدرون P(3, 4, 12) فوق الأرض، ونقطة Q على محور x يحركها مؤشر. خط من Q إلى الدرون مكتوب عليه طوله، ومؤشر يلفّ المشهد."
      x: [-1, 6]
      y: [0, 5]
      z: [0, 13]
      param q = 0 { range: [-1, 6], step: 0.5 }
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 15]
      point3 drone = (3, 4, 12) { color: warning, r: 7, guides, label: "P" }
      point3 Q = (q, 0, 0) { color: dist, r: 6, label: "Q" }
      segment3 pq = (q, 0, 0) -> (3, 4, 12) { color: dist, width: 3, label: "${fixed(sqrt((q - 3)^2 + 160), 2)}" }
      slider q { label: "موضع Q على محور x" }
      slider az { label: "لفّ المشهد" }
    }

    goal "ضع $Q$ في أقرب نقطة من محور $x$ إلى الدرون" {
      when: q == 3
      hints: ["راقب الرقم على الخط وهو يصغر ثم يكبر.", "أقصر خط إلى المحور يلقاه بزاوية قائمة."]
      showme: { q: 3 }
    }

    numeric {
      ask "أقرب ما يصل إليه الخط ليس $3$ أبدًا. إذن كم يبعد الدرون $P(3, 4, 12)$ عن محور $y$؟"
      skill: "sg-3d-points"
      answer: sqrt(153)
      expect: sqrt(3^2 + 12^2)
      tolerance: 0.01
      unit: "م"
      wrong 4 "هذا $y$ نفسه، الفخ الذي رأيته للتو. $y$ يقول أين تقع النقطة بمحاذاة المحور، لا كم تبعد عنه." -> "sg1-d-axis" retry
      wrong 5 "$5$ بعده عن محور $z$، السارية. محور $y$ غيره."
      wrong 13 "$13$ بعده عن $O$. أقرب نقطة على محور $y$ ليست $O$."
      wrong sqrt(160) "هذا بعده عن محور $x$ الذي وجدته للتو. محور $y$ مختلف."
      hint "أقرب نقطة على محور $y$ هي $(0, 4, 0)$."
      hint "من هناك إلى الدرون: كم تتحرك في $x$؟ وكم في $z$؟"
      after: goals
      ! "أقرب نقطة هي $(0, 4, 0)$، ومنها $3$ في $x$ و $12$ في $z$ بزاوية قائمة: $\sqrt{3^2 + 12^2} \approx 12.37$. الإحداثي $y$ نفسه لا يدخل الحساب."
    }
  }

  slide "محور z لا يهتم بـ z" {
    id: "sg1-d-axis"
    beat: detour
    hidden: true
    cat: "البعد عن المستويات والمحاور"
    > مغرٍ أن تأخذ إحداثي المحور نفسه، لأنه ينجح مع المستويات. لكن إحداثي المحور يقول **أين** تقع النقطة بمحاذاته، لا كم تبعد عنه. ارفع النقطة وراقب بعدها عن محور $z$.

    scene space3 {
      alt: "نقطة فوق (3, 4) يرفعها مؤشر، وخط أفقي منها إلى محور z مكتوب عليه طوله، ومؤشر يلفّ المشهد."
      x: [0, 5]
      y: [0, 5]
      z: [0, 8]
      param c = 0 { range: [0, 8], step: 1 }
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 18]
      point3 A = (3, 4, c) { color: warning, r: 6, label: "(3, 4, ${c})" }
      point3 foot = (0, 0, c) { color: dist, r: 4 }
      segment3 d = (0, 0, c) -> (3, 4, c) { color: dist, width: 3, label: "${fixed(sqrt(3^2 + 4^2), 2)}" }
      slider c { label: "ارتفاع النقطة" }
      slider az { label: "لفّ المشهد" }
    }

    goal "ارفع النقطة إلى ارتفاع $6$ على الأقل" {
      when: c >= 6
      hints: ["اسحب مؤشر الارتفاع، وعينك على الرقم فوق الخط."]
      showme: { c: 6 }
    }

    numeric {
      ask "كم تبعد النقطة $(6, -8, 5)$ عن محور $z$؟"
      skill: "sg-3d-points"
      answer: 10
      expect: sqrt(6^2 + (-8)^2)
      wrong 5 "هذا $z$ نفسه، وقد رأيت أنه لا يغيّر البعد عن محور $z$ أبدًا."
      wrong sqrt(125) "هذا بعدها عن نقطة الأصل."
      after: goals
      ! "محور $z$ يُسقط $z$ ويأخذ الآخرين: $\sqrt{6^2 + (-8)^2} = 10$."
    }
  }

  slide "القاعدة لأي نقطة" {
    id: "sg1-name-axis"
    beat: name
    cat: "البعد عن المستويات والمحاور"
    > حسبت بعد الدرون عن محور $y$ من $3$ و $12$، ولم يدخل $y$ الحساب. الآن لأي نقطة $(a, b, c)$.

    quiz {
      ask "البُعد بين النقطة $(a, b, c)$ ومحور $y$ يساوي:"
      skill: "sg-3d-points"
      * "$\sqrt{a^2 + c^2}$"
      - "$\sqrt{a^2 + b^2}$" { why: "هذا يستخدم $b$، أي $y$ نفسه، ويترك $c$. هو البعد عن محور $z$.", onwrong: "sg1-d-axis", retry }
      - "$\sqrt{b^2 + c^2}$" { why: "هذا يترك $a$، فهو البعد عن محور $x$.", onwrong: "sg1-d-axis", retry }
      - "$\sqrt{a^2 + b^2 + c^2}$" { why: "هذا البعد عن نقطة الأصل. أقرب نقطة على المحور ليست $O$ في العادة." }
      ! "المحور يُسقط إحداثيه ويأخذ الآخرين: عن محور $x$ هو $\sqrt{b^2 + c^2}$، وعن $y$ هو $\sqrt{a^2 + c^2}$، وعن $z$ هو $\sqrt{a^2 + b^2}$."
    }
  }

  slide "الرقم الصحيح للسبب الخطأ" {
    id: "sg1-breaker-axis"
    beat: breaker
    cat: "البعد عن المستويات والمحاور"
    > هذه تخدع. طول العمود المرسوم من النقطة $(-5, -3, 4)$ على محور $x$ يساوي $5$ وحدات فعلًا.

    quiz {
      ask "أي حساب يعطي هذا الطول للسبب الصحيح؟"
      skill: "sg-3d-points"
      - "$|-5| = 5$" { why: "الرقم صحيح هنا بالصدفة. $|x|$ هو البعد عن الجدار $yz$، لا عن محور $x$. جرّب $(-5, 6, 8)$: تبعد عن محور $x$ عشر وحدات.", onwrong: "sg1-d-axis", retry }
      * "$\sqrt{(-3)^2 + 4^2} = 5$"
      - "$\sqrt{(-5)^2 + (-3)^2} \approx 5.83$" { why: "هذا يستخدم $x$ و $y$، فهو البعد عن محور $z$." }
      - "$\sqrt{25 + 9 + 16} \approx 7.07$" { why: "هذا البعد عن نقطة الأصل." }
      ! "محور $x$ يُسقط $x$: $\sqrt{(-3)^2 + 4^2} = 5$. أن يساوي $|x|$ هنا مجرد صدفة، والطريقة هي ما يبقى معك."
    }
  }

  slide "مثال محلول: نقطة مجهولة" {
    id: "sg1-worked-axis"
    beat: example
    cat: "البعد عن المستويات والمحاور"
    > مثال من الكتاب، وأنت تقود الحل خطوة خطوة.

    moves {
      ask "النقطة $A(4m, 3m, m + 1)$ تبعد $5$ وحدات عن محور $z$. أوجد $A$."
      skill: "sg-3d-points"
      from "$A(4m, 3m, m + 1)$ ، وبعدها عن محور $z$ يساوي $5$"
      move "$\sqrt{(4m)^2 + (3m)^2} = 5$" {
        * "البعد عن محور $z$ يستخدم $x$ و $y$ فقط"
        - "نستخدم الإحداثيات الثلاثة" { why: "هذا بعدها عن نقطة الأصل. محور $z$ لا يهتم بـ $z$." }
        - "نكتب $|m + 1| = 5$" { why: "$|z|$ هو البعد عن الأرض $xy$، لا عن محور $z$." }
      }
      move "$16m^2 + 9m^2 = 25$" {
        * "نربّع الطرفين"
        - "نكتب $4m + 3m = 5$" { why: "الجذر لا يتوزع على الجمع: $\sqrt{p^2 + q^2}$ ليس $p + q$." }
      }
      move "$m^2 = 1$ ، أي $m = \pm 1$" {
        * "نجمع ونقسم على $25$ ونأخذ الجذرين"
        - "نأخذ $m = 1$ فقط" { why: "$(-1)^2 = 1$ أيضًا، فالحل السالب صحيح بالقدر نفسه." }
      }
      move "$A(4, 3, 2)$ أو $A(-4, -3, 0)$" {
        * "نعوّض بكل قيمة في الإحداثيات الثلاثة"
        - "نعوّض في $x$ و $y$ فقط" { why: "النقطة تحتاج إحداثيها الثالث أيضًا: $z = m + 1$." }
      }
      ! "نقطتان تحققان الشرط: $A(4, 3, 2)$ و $A(-4, -3, 0)$. تحقّق: $\sqrt{16 + 9} = 5$ في الحالتين."
    }
  }

  slide "أكمل أنت" {
    id: "sg1-faded-plane"
    beat: example
    cat: "البعد عن المستويات والمحاور"
    > مثال آخر من الكتاب: $A(2 + m, 3 - m, m)$ تقع في المستوى $xz$، فإحداثيها $y$ صفر: $3 - m = 0$. أكمل أنت.

    numeric {
      ask "ما الإحداثي $x$ للنقطة $A$؟"
      skill: "sg-3d-points"
      answer: 5
      expect: 2 + 3
      wrong 2 "هذا بعد تصفير $z$، أي $m = 0$. المستوى $xz$ يصفّر $y$." -> "sg1-d-plane" retry
      wrong 0 "صفّرت $x$ نفسه. المستوى $xz$ يصفّر $y$." -> "sg1-d-plane" retry
      wrong -1 "$3 - m = 0$ يعطي $m = 3$ لا $-3$."
      hint "من $3 - m = 0$، ما $m$؟"
      ! "$m = 3$، فـ $A(5, 0, 3)$."
    }
  }

  slide "على محور y" {
    id: "sg1-ex22"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    quiz {
      ask "النقطة $A(3l, l + 3, 5l)$ تقع على محور $y$. ما $A$؟"
      skill: "sg-3d-points"
      * "$(0, 3, 0)$"
      - "$(-9, 0, -15)$" { why: "هذا تصفير $y$، وهو شرط المستوى $xz$. على محور $y$ يُصفّر $x$ و $z$.", onwrong: "sg1-d-plane", retry }
      - "$(3, 4, 5)$" { why: "هذا $l = 1$. على محور $y$ يجب $3l = 0$ و $5l = 0$." }
      - "$(0, 0, 0)$" { why: "نصفّر $x$ و $z$ فقط، ويبقى $y = l + 3 = 3$." }
      ! "على محور $y$: $3l = 5l = 0$ فـ $l = 0$ و $A(0, 3, 0)$."
    }
  }

  slide "حلان لا حل واحد" {
    id: "sg1-ex23"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    quiz {
      ask "النقطة $A(2 + k, 4k, -k)$ تبعد $5$ وحدات طول عن المستوى $yz$. ما $A$؟"
      skill: "sg-3d-points"
      - "$(5, 12, -3)$ فقط" { why: "$|2 + k| = 5$ له حلان: $k = 3$ و $k = -7$." }
      - "$(7, 20, -5)$" { why: "هذا $k = 5$. البعد $5$ هو $|x| = |2 + k|$، لا $k$ نفسه." }
      * "$(5, 12, -3)$ أو $(-5, -28, 7)$"
      - "$(-3, -20, 5)$" { why: "هذا من $-k = 5$، أي البعد عن الأرض $xy$. المطلوب البعد عن $yz$." }
      ! "البعد عن $yz$ هو $|x| = |2 + k| = 5$، فـ $k = 3$ أو $k = -7$، والنقطتان $(5, 12, -3)$ و $(-5, -28, 7)$."
    }
  }

  slide "تمرين: في المستوى xy" {
    id: "sg1-e61"
    beat: example
    cat: "البعد عن المستويات والمحاور"
    > تمارين الكتاب، واحدًا واحدًا.

    numeric {
      ask "النقطة $A(1 - k, 2k, 3 + k)$ تقع في المستوى $xy$. ما الإحداثي $y$ للنقطة $A$؟"
      skill: "sg-3d-points"
      answer: -6
      expect: 2 * (0 - 3)
      wrong 0 "صفّرت $y$. المستوى $xy$ يصفّر $z$." -> "sg1-d-plane" retry
      wrong 6 "$k = -3$، فـ $2k = -6$. انتبه للإشارة."
      hint "في $xy$ يكون $z = 0$."
      ! "$3 + k = 0$ فـ $k = -3$ و $A(4, -6, 0)$."
    }
  }

  slide "تمرين: على محور z" {
    id: "sg1-e62"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    numeric {
      ask "النقطة $A(0, m - 3, m + 4)$ تقع على محور $z$. ما الإحداثي $z$ للنقطة $A$؟"
      skill: "sg-3d-points"
      answer: 7
      expect: 3 + 4
      wrong 0 "على محور $z$ يُصفّر $x$ و $y$، ويبقى $z$ حرًّا."
      wrong 4 "هذا $m = 0$. الشرط هو $y = m - 3 = 0$."
      wrong 1 "$m - 3 = 0$ يعطي $m = 3$ لا $-3$."
      hint "على محور $z$، أي إحداثيين يساويان صفرًا؟"
      ! "$x = 0$ أصلًا، و $m - 3 = 0$ فـ $m = 3$ و $A(0, 0, 7)$."
    }
  }

  slide "تمرين: في مستوى يوازي جدارًا" {
    id: "sg1-e63"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    quiz {
      ask "النقطة $A(n - 1, n + 4, 5n)$ تقع في المستوى $y = 5$. ما $A$؟"
      skill: "sg-3d-points"
      - "$(-5, 0, -20)$" { why: "هذا تصفير $y$، أي الجدار $xz$. المستوى هنا $y = 5$ يوازيه." }
      * "$(0, 5, 5)$"
      - "$(4, 9, 25)$" { why: "هذا $n = 5$. المطلوب $n + 4 = 5$، لا $n = 5$." }
      ! "$n + 4 = 5$ فـ $n = 1$ و $A(0, 5, 5)$."
    }
  }

  slide "تمرين: بعد عن محور x" {
    id: "sg1-e64"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    quiz {
      ask "النقطة $A(l + 5, 2l, l)$ تبعد $2\sqrt{5}$ وحدة طول عن محور $x$. ما $A$؟"
      skill: "sg-3d-points"
      * "$(7, 4, 2)$ أو $(3, -4, -2)$"
      - "$(7, 4, 2)$ فقط" { why: "$l^2 = 4$ له حلان، $2$ و $-2$." }
      - "$(3, -4, -2)$ فقط" { why: "$l = 2$ يحقق الشرط أيضًا: $\sqrt{16 + 4} = 2\sqrt{5}$." }
      - "$(5, 0, 0)$" { why: "هذا $l = 0$، وهو على محور $x$ نفسه، على بعد صفر منه." }
      ! "محور $x$ يأخذ $y$ و $z$: $\sqrt{4l^2 + l^2} = 2\sqrt{5}$، فـ $5l^2 = 20$ و $l = \pm 2$."
    }
  }

  slide "تمرين: على محور x" {
    id: "sg1-e65"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    numeric {
      ask "النقطة $A(m, 2m - n, m + n + 3)$ تقع على محور $x$. ما الإحداثي $x$ للنقطة $A$؟"
      skill: "sg-3d-points"
      answer: -1
      expect: (0 - 3) / 3
      wrong 1 "انتبه للإشارة: $3m + 3 = 0$ يعطي $m = -1$."
      wrong 0 "على محور $x$ يكون $x$ حرًّا. الصفران هما $y$ و $z$."
      hint "على محور $x$: $y = 0$ و $z = 0$. معادلتان في $m$ و $n$."
      ! "$2m - n = 0$ و $m + n + 3 = 0$، فـ $n = 2m$ و $3m + 3 = 0$، أي $m = -1$ و $A(-1, 0, 0)$."
    }
  }

  slide "تمرين: مجهول في الإحداثي الثالث" {
    id: "sg1-axis-24"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    quiz {
      ask "بُعد النقطة $(-3, 4, a)$ عن محور $y$ يساوي $5$ وحدات. ما $a$؟"
      skill: "sg-3d-points"
      - "$5$" { why: "$5$ هو البعد نفسه، لا $a$." }
      * "$\pm 4$"
      - "$\pm 3$" { why: "هذا من $\sqrt{4^2 + a^2} = 5$، أي البعد عن محور $x$. محور $y$ يأخذ $x$ و $z$.", onwrong: "sg1-d-axis", retry }
      - "$12$" { why: "عوّض: $\sqrt{9 + 144}$ أكبر بكثير من $5$." }
      ! "$\sqrt{(-3)^2 + a^2} = 5$، فـ $a^2 = 16$ و $a = \pm 4$."
    }
  }

  slide "تمرين: بعدان متساويان" {
    id: "sg1-axis-25"
    beat: example
    cat: "البعد عن المستويات والمحاور"

    quiz {
      ask "النقطة $(k, 3, -5)$ على بعدين متساويين من المحورين $x$ و $y$. ما $k$؟"
      skill: "sg-3d-points"
      - "$\pm 2$" { why: "عن محور $x$: $\sqrt{9 + 25}$، وعن $y$: $\sqrt{k^2 + 25}$. مع $k = 2$ يصير $\sqrt{29}$." }
      * "$\pm 3$"
      - "$\pm 4$" { why: "مع $k = 4$ يصير البعد عن محور $y$ هو $\sqrt{41}$، لا $\sqrt{34}$." }
      - "$\pm 5$" { why: "هذا يساوي $|k|$ بـ $|z|$. لكن $z$ داخل البعدين معًا، فيُلغى." }
      ! "$\sqrt{3^2 + (-5)^2} = \sqrt{k^2 + (-5)^2}$، فـ $k^2 = 9$ و $k = \pm 3$."
    }
  }

  slide "متوازي مستطيلات" {
    id: "sg1-box"
    beat: example
    cat: "متوازي المستطيلات"
    > من أمثلة الكتاب: متوازي مستطيلات أحد رؤوسه $O$، وثلاثة من أوجهه على المستويات الإحداثية، ورأسه المقابل $A(3, 7, 5)$.

    scene space3 {
      alt: "متوازي مستطيلات أبعاده 3 و 7 و 5 أحد رؤوسه عند O. على الأرض: O و D' على محور x و B' على محور y و A'. في الأعلى: C فوق O و D و B و A(3, 7, 5)."
      x: [0, 4]
      y: [0, 8]
      z: [0, 6]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      box(3, 7, 5)
      label3 at (-0.3, -0.5, -0.3) = "O"
      label3 at (3.4, -0.4, 0) = "D'"
      label3 at (3.4, 7.4, 0) = "A'"
      label3 at (0, 7.5, -0.3) = "B'"
      label3 at (-0.3, -0.4, 5.4) = "C"
      label3 at (3.3, -0.4, 5.4) = "D"
      label3 at (0, 7.4, 5.5) = "B"
      label3 at (3.4, 7.4, 5.5) = "A(3, 7, 5)" { color: warning }
      slider az { label: "لفّ المشهد" }
    }

    match {
      ask "صِل كل رأس بإحداثياته، ثم الحجم."
      skill: "sg-3d-points"
      pair "$B$" -> "$(0, 7, 5)$"
      pair "$B'$" -> "$(0, 7, 0)$"
      pair "$C$" -> "$(0, 0, 5)$"
      pair "$D$" -> "$(3, 0, 5)$"
      pair "$D'$" -> "$(3, 0, 0)$"
      pair "$A'$" -> "$(3, 7, 0)$"
      pair "الحجم" -> "$105$ وحدة مكعبة"
      decoy "$(7, 0, 5)$"
      decoy "$15$ وحدة مكعبة"
      miss "$B$" -> "$(7, 0, 5)$" "$B$ فوق محور $y$، فإحداثيه $x$ صفر و $y = 7$. الترتيب دائمًا $(x, y, z)$."
      miss "الحجم" -> "$15$ وحدة مكعبة" "هذا مجموع الأبعاد. الحجم حاصل ضربها: $3 \times 7 \times 5$."
      hint "كل رأس يأخذ من $A$ ما يشاركه فيه، ويضع صفرًا مكان الباقي."
      ! "$B$ في الجدار $yz$ فـ $(0, 7, 5)$، و $C$ على محور $z$، و $D'$ على محور $x$. والحجم $3 \times 7 \times 5 = 105$ وحدة مكعبة."
    }
  }

  slide "الشكل نفسه بأبعاد أخرى" {
    id: "sg1-box-40"
    beat: example
    cat: "متوازي المستطيلات"
    > الرسم نفسه والتسمية نفسها، لكن الرأس المقابل لـ $O$ صار $A(5, 8, 4)$.

    match {
      ask "أوجد $B$ و $C$."
      skill: "sg-3d-points"
      pair "$B$" -> "$(0, 8, 4)$"
      pair "$C$" -> "$(0, 0, 4)$"
      decoy "$(4, 8, 0)$"
      decoy "$(5, 8, 0)$"
      decoy "$(5, 0, 4)$"
      miss "$B$" -> "$(5, 8, 0)$" "هذا الرأس تحت $A$ على الأرض، $A'$. أما $B$ ففي الوجه العلوي فوق محور $y$."
      miss "$C$" -> "$(5, 0, 4)$" "هذا $D$، فوق محور $x$. أما $C$ ففوق $O$ مباشرة على محور $z$."
      miss "$B$" -> "$(4, 8, 0)$" "الأبعاد تبادلت أماكنها. $B$ فوق محور $y$: $x = 0$ و $y = 8$ و $z = 4$."
      ! "$B(0, 8, 4)$ في الجدار $yz$، و $C(0, 0, 4)$ على محور $z$."
    }
  }

  slide "تسمية أخرى" {
    id: "sg1-box-42"
    beat: example
    cat: "متوازي المستطيلات"
    > تمرين من الكتاب بتسمية مختلفة، فاقرأ الرسم جيدًا: $C'(5, 8, 0)$ و $D(5, 0, 3)$.

    scene space3 {
      alt: "متوازي مستطيلات أبعاده 5 و 8 و 3. على الأرض: O و D' على محور x و B' على محور y و C'(5, 8, 0). في الأعلى: A فوق O و D(5, 0, 3) و B و C."
      x: [0, 6]
      y: [0, 9]
      z: [0, 4]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      box(5, 8, 3)
      label3 at (-0.3, -0.5, -0.3) = "O"
      label3 at (5.4, -0.4, 0) = "D'"
      label3 at (5.4, 8.4, -0.2) = "C'(5, 8, 0)" { color: warning }
      label3 at (0, 8.5, -0.3) = "B'"
      label3 at (-0.3, -0.4, 3.4) = "A"
      label3 at (5.3, -0.4, 3.5) = "D(5, 0, 3)" { color: warning }
      label3 at (0, 8.4, 3.5) = "B"
      label3 at (5.4, 8.4, 3.5) = "C"
      slider az { label: "لفّ المشهد" }
    }

    match {
      ask "صِل كل سؤال بجوابه."
      skill: "sg-3d-points"
      pair "النقطة $C$" -> "$(5, 8, 3)$"
      pair "الحجم" -> "$120$ وحدة مكعبة"
      pair "معادلة المستوى $OB'C'D'$" -> "$z = 0$"
      pair "معادلة المستوى $DD'C'C$" -> "$x = 5$"
      decoy "$(5, 3, 8)$"
      decoy "$144$ وحدة مكعبة"
      decoy "$y = 0$"
      decoy "$z = 3$"
      miss "معادلة المستوى $OB'C'D'$" -> "$z = 3$" "$z = 3$ هو الوجه العلوي. الرؤوس $O$ و $B'$ و $C'$ و $D'$ كلها على الأرض."
      miss "النقطة $C$" -> "$(5, 3, 8)$" "الترتيب $(x, y, z)$: $x = 5$ و $y = 8$ من $C'$، و $z = 3$ من $D$."
      miss "معادلة المستوى $DD'C'C$" -> "$y = 0$" "$y = 0$ هو الجدار $xz$ عند $O$. هذا الوجه في المقدمة، كل رؤوسه فيها $x = 5$."
      ! "$C(5, 8, 3)$ فوق $C'$. الحجم $5 \times 8 \times 3 = 120$. الأرض $z = 0$، والوجه الأمامي كل نقاطه $x = 5$."
    }
  }

  slide "مكعب" {
    id: "sg1-cube-41"
    beat: example
    cat: "متوازي المستطيلات"
    > مكعب طول حرفه $5$ وحدات، بتسمية التمرين السابق نفسها.

    scene space3 {
      alt: "مكعب حرفه 5 أحد رؤوسه O. على الأرض: O و D' على محور x و B' على محور y و C'. في الأعلى: A فوق O و D و B و C. خط منقط من O إلى C."
      x: [0, 6]
      y: [0, 6]
      z: [0, 6]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 22]
      box(5, 5, 5)
      segment3 diag = (0, 0, 0) -> (5, 5, 5) { color: dist, style: dashed, width: 2 }
      label3 at (-0.3, -0.5, -0.3) = "O"
      label3 at (5.4, -0.4, 0) = "D'"
      label3 at (5.4, 5.4, -0.2) = "C'"
      label3 at (0, 5.5, -0.3) = "B'"
      label3 at (-0.3, -0.4, 5.4) = "A"
      label3 at (5.3, -0.4, 5.5) = "D"
      label3 at (0, 5.4, 5.5) = "B"
      label3 at (5.4, 5.4, 5.5) = "C"
      slider az { label: "لفّ المشهد" }
    }

    match {
      ask "صِل كل سؤال بجوابه."
      skill: "sg-3d-points"
      pair "النقطة $C$" -> "$(5, 5, 5)$"
      pair "النقطة $D'$" -> "$(5, 0, 0)$"
      pair "طول قطر المكعب $OC$" -> "$5\sqrt{3}$"
      decoy "$5\sqrt{2}$"
      decoy "$(5, 5, 0)$"
      decoy "$(0, 5, 5)$"
      miss "طول قطر المكعب $OC$" -> "$5\sqrt{2}$" "هذا قطر وجه، على الأرض من $O$ إلى $C'$. القطر الكامل يصعد $5$ أيضًا: $\sqrt{25 + 25 + 25}$."
      miss "النقطة $C$" -> "$(5, 5, 0)$" "هذا $C'$ تحته على الأرض."
      ! "$C(5, 5, 5)$ و $D'(5, 0, 0)$. والقطر فيثاغورس مرتين كالدرون: $\sqrt{5^2 + 5^2 + 5^2} = 5\sqrt{3}$."
    }
  }

  slide "مكعب من حجمه" {
    id: "sg1-cube-27"
    beat: example
    cat: "متوازي المستطيلات"

    quiz {
      ask "مكعب حجمه $27$ وحدة مكعبة، أحد رؤوسه $O$ وأحرفه على الاتجاهات الموجبة للمحاور. ما الرأس المقابل لـ $O$؟"
      skill: "sg-3d-points"
      - "$(9, 9, 9)$" { why: "$27 \div 3 = 9$، لكن الحجم حاصل ضرب الأحرف لا مجموعها. الحرف $\sqrt[3]{27}$." }
      - "$(3, 3, 0)$" { why: "هذا رأس على الأرض. الرأس المقابل لـ $O$ يرتفع أيضًا." }
      * "$(3, 3, 3)$"
      - "$(27, 27, 27)$" { why: "$27$ هو الحجم، لا طول الحرف." }
      ! "الحرف $\sqrt[3]{27} = 3$، فكل رأس إحداثياته $0$ أو $3$، مثل $(3, 0, 0)$ و $(3, 3, 0)$ و $(0, 3, 3)$. والمقابل لـ $O$ هو $(3, 3, 3)$."
    }
  }

  slide "من A إلى B" {
    id: "sg1-dist-name"
    beat: name
    cat: "البعد بين نقطتين"
    > الدرون كان يبعد عن $O$ بفيثاغورس على حركاته الثلاث. من $A$ إلى $B$ الفكرة نفسها، لكن الحركات صارت فروقًا: كم نتحرك في $x$، وفي $y$، وفي $z$.

    scene space3 {
      alt: "النقطتان A و B، وبينهما ثلاث حركات متعامدة: فرق x ثم فرق y على مستوى واحد، ثم فرق z لأعلى، والخط المستقيم AB. مؤشر يلفّ المشهد."
      x: [0, 5]
      y: [0, 6]
      z: [0, 4]
      param az = 55 { range: [0, 360], step: 5 }
      camera: [az, 18]
      segment3 dx = (1, 1, 1) -> (4, 1, 1) { color: ground, width: 3, label: "x2 − x1" }
      segment3 dy = (4, 1, 1) -> (4, 5, 1) { color: ground, width: 3, label: "y2 − y1" }
      segment3 dz = (4, 5, 1) -> (4, 5, 3) { color: up, width: 3, label: "z2 − z1" }
      segment3 ab = (1, 1, 1) -> (4, 5, 3) { color: dist, width: 3 }
      point3 A = (1, 1, 1) { color: neutral, label: "A" }
      point3 B = (4, 5, 3) { color: warning, label: "B" }
      slider az { label: "لفّ المشهد" }
    }

    build {
      ask "ابنِ مربع البعد بين $A(x_1, y_1, z_1)$ و $B(x_2, y_2, z_2)$."
      skill: "sg-3d-distance"
      template: "$AB^2 =$ ___ $+$ ___ $+$ ___"
      bank: ["$(x_2 - x_1)^2$", "$(y_2 - y_1)^2$", "$(z_2 - z_1)^2$", "$(x_2 + x_1)^2$", "$(z_2 - z_1)$"]
      answer: ["$(x_2 - x_1)^2$", "$(y_2 - y_1)^2$", "$(z_2 - z_1)^2$"]
      answer: ["$(x_2 - x_1)^2$", "$(z_2 - z_1)^2$", "$(y_2 - y_1)^2$"]
      answer: ["$(y_2 - y_1)^2$", "$(x_2 - x_1)^2$", "$(z_2 - z_1)^2$"]
      answer: ["$(y_2 - y_1)^2$", "$(z_2 - z_1)^2$", "$(x_2 - x_1)^2$"]
      answer: ["$(z_2 - z_1)^2$", "$(x_2 - x_1)^2$", "$(y_2 - y_1)^2$"]
      answer: ["$(z_2 - z_1)^2$", "$(y_2 - y_1)^2$", "$(x_2 - x_1)^2$"]
      miss "$(x_2 + x_1)^2$" "الحركة فرق بين موضعين، لا مجموعهما."
      miss "$(z_2 - z_1)$" "كل حركة تُربّع، مثل الحركتين الأخريين."
      hint "كل حركة على الرسم فرق بين إحداثيين."
      ! "$AB = \sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2 + (z_2 - z_1)^2}$. هو قانون البعد في المستوى مع حد ثالث للارتفاع."
    }
  }

  slide "مثال محلول: البعد بين نقطتين" {
    id: "sg1-dist-worked"
    beat: example
    cat: "البعد بين نقطتين"
    > مثال الكتاب، وأنت تختار كل خطوة.

    moves {
      ask "أوجد البعد بين $A(2, -3, 5)$ و $B(4, 1, -1)$."
      skill: "sg-3d-distance"
      from "$A(2, -3, 5)$ ، $B(4, 1, -1)$"
      move "$AB = \sqrt{(4 - 2)^2 + (1 - (-3))^2 + (-1 - 5)^2}$" {
        * "نطرح الإحداثيات المتناظرة ونربّع"
        - "نجمع الإحداثيات المتناظرة" { why: "الحركة من $A$ إلى $B$ فرق بين موضعيهما، لا مجموعهما." }
        - "نطرح $x$ و $y$ فقط" { why: "هذا قانون المستوى. في الفراغ حد ثالث لـ $z$." }
      }
      move "$= \sqrt{4 + 16 + 36}$" {
        * "نحسب كل فرق ثم نربّعه"
        - "نكتب $1 - (-3) = -2$" { why: "طرح السالب جمع: $1 - (-3) = 1 + 3 = 4$." }
      }
      move "$= \sqrt{56} = 2\sqrt{14}$" {
        * "نجمع ثم نبسّط: $56 = 4 \times 14$"
        - "نجذر كل حد: $2 + 4 + 6 = 12$" { why: "جذر المجموع ليس مجموع الجذور، كما رأيت مع الدرون." }
      }
      ! "$AB = 2\sqrt{14} \approx 7.48$ وحدة طول."
    }
  }

  slide "أكمل الحساب" {
    id: "sg1-dist-faded"
    beat: example
    cat: "البعد بين نقطتين"
    > من تمارين الكتاب: $A(1, 1, -7)$ و $B(-2, -3, -7)$، و $AB = \sqrt{(-2 - 1)^2 + (-3 - 1)^2 + (-7 - (-7))^2}$. أكمل.

    numeric {
      ask "ما $AB$؟"
      skill: "sg-3d-distance"
      answer: 5
      expect: sqrt((-2 - 1)^2 + (-3 - 1)^2 + (-7 + 7)^2)
      unit: "وحدة طول"
      wrong sqrt(221) "$-7 - (-7) = 0$، لا $-14$. طرح السالب جمع." -> "sg1-d-sign" retry
      wrong 7 "هذا $3 + 4$. ربّع الفروق واجمعها، ثم خذ الجذر."
      hint "الفرق الأخير: $-7 - (-7)$. كم هو؟"
      ! "$\sqrt{9 + 16 + 0} = 5$. النقطتان على الارتفاع نفسه، فعاد السؤال إلى المستوى."
    }
  }

  slide "طرح السالب" {
    id: "sg1-d-sign"
    beat: detour
    hidden: true
    cat: "البعد بين نقطتين"
    > أكثر خطأ شيوعًا هنا إشارة واحدة. طرح عدد سالب جمع: $1 - (-3) = 4$، و $-7 - (-7) = 0$. اكتب كل فرق بين قوسين قبل أن تربّعه.

    numeric {
      ask "أوجد البعد بين $A(-1, 2, -3)$ و $B(1, -1, 3)$."
      skill: "sg-3d-distance"
      answer: 7
      expect: sqrt((1 + 1)^2 + (-1 - 2)^2 + (3 + 3)^2)
      wrong sqrt(13) "الفرق في $z$ هو $3 - (-3) = 6$، لا $0$."
      wrong sqrt(4 + 1 + 36) "الفرق في $y$ هو $-1 - 2 = -3$."
      hint "الفروق: $1 - (-1)$، ثم $-1 - 2$، ثم $3 - (-3)$."
      ! "الفروق $2$ و $-3$ و $6$، فالبعد $\sqrt{4 + 9 + 36} = 7$."
    }
  }

  slide "ثلاثة أبعاد في جدول" {
    id: "sg1-dist-table"
    beat: example
    cat: "البعد بين نقطتين"
    > ثلاثة من تمارين الكتاب مرة واحدة. قرّب لمنزلتين عشريتين.

    table {
      ask "أوجد $AB$: (1) $A(7, 0, 4)$ ، $B(1, 0, 0)$ (2) $A(4, 1, 9)$ ، $B(2, 1, 6)$ (3) $A(7, -1, 8)$ ، $B(11, 2, -4)$"
      skill: "sg-3d-distance"
      header: ["(1)", "(2)", "(3)"]
      row: blank(sqrt(52)), blank(sqrt(13)), blank(13)
      tolerance: 0.01
      hint "في كل حالة: ثلاثة فروق، تربيع، جمع، جذر."
      ! "(1) $\sqrt{36 + 0 + 16} = 2\sqrt{13}$ (2) $\sqrt{4 + 0 + 9} = \sqrt{13}$ (3) $\sqrt{16 + 9 + 144} = 13$."
    }
  }

  slide "بأرقام جديدة" {
    id: "sg1-dist-vary"
    beat: example
    cat: "البعد بين نقطتين"
    > هذا السؤال يأتيك بأرقام جديدة في كل محاولة.

    numeric {
      vary a in [3, 5, -1]
      vary b in [4, 6, -2]
      ask "أوجد البعد بين $A(${a}, 2, -1)$ و $B(1, ${b}, 3)$. قرّب لمنزلتين عشريتين."
      skill: "sg-3d-distance"
      answer: sqrt((a - 1)^2 + (b - 2)^2 + 16)
      expect: sqrt((1 - a)^2 + (b - 2)^2 + (3 - (0 - 1))^2)
      tolerance: 0.01
      wrong sqrt((a - 1)^2 + (b - 2)^2 + 4) "الفرق في $z$ هو $3 - (-1) = 4$، لا $2$." -> "sg1-d-sign" retry
      hint "انتبه لـ $z$: من $-1$ إلى $3$."
      ! "ثلاثة فروق، كل واحد مربّع، ثم الجذر. الفرق في $z$ دائمًا $4$ هنا."
    }
  }

  slide "البعد عن نقطة الأصل" {
    id: "sg1-dist-20"
    beat: example
    cat: "البعد بين نقطتين"

    quiz {
      ask "بُعد النقطة $(-3, 4, 5)$ عن نقطة الأصل = … وحدة طول."
      skill: "sg-3d-distance"
      - "$5$" { why: "هذا $\sqrt{9 + 16}$، أي بعدها عن محور $z$. نقطة الأصل تحتاج $z$ أيضًا." }
      * "$5\sqrt{2}$"
      - "$10$" { why: "$10$ يحتاج مجموع مربعات $100$، وهنا $9 + 16 + 25 = 50$." }
      - "$25$" { why: "مجموع المربعات $50$، ثم الجذر. $25$ ليس هذا ولا ذاك." }
      ! "$\sqrt{9 + 16 + 25} = \sqrt{50} = 5\sqrt{2}$."
    }
  }

  slide "المجهول داخل البعد" {
    id: "sg1-dist-21"
    beat: breaker
    cat: "البعد بين نقطتين"

    quiz {
      ask "$A(-4, -2, 3)$ و $B(1, 2, k)$، وطول $\overline{AB} = \sqrt{77}$. ما $k$؟"
      skill: "sg-3d-distance"
      - "$-3$ أو $6$" { why: "$k = 6$ يعطي $(6 - 3)^2 = 9$ لا $36$. عوّض لتتأكد." }
      - "$-3$ أو $12$" { why: "$k = 12$ يعطي $(12 - 3)^2 = 81$ لا $36$." }
      - "$9$ أو $6$" { why: "$k = 6$ لا يحقق: $25 + 16 + 9 = 50$." }
      * "$9$ أو $-3$"
      hint "$25 + 16 + (k - 3)^2 = 77$."
      ! "$(k - 3)^2 = 36$، فـ $k - 3 = \pm 6$: $k = 9$ أو $k = -3$. المربع يعطي حلين دائمًا."
    }
  }

  slide "مثلث متساوي الأضلاع" {
    id: "sg1-dist-38"
    beat: example
    cat: "البعد بين نقطتين"

    numeric {
      ask "المثلث الذي رؤوسه $(4, 5, 2)$ و $(1, k, 3)$ و $(2, 4, 5)$ متساوي الأضلاع. ما $k$؟"
      skill: "sg-3d-distance"
      answer: 7
      expect: 5 + 2
      wrong 3 "$k = 3$ يجعل ضلعًا واحدًا $\sqrt{14}$، لكن الضلع الثالث يصير $\sqrt{6}$. الأضلاع الثلاثة يجب أن تتساوى."
      wrong 1 "$k = 1$ يجعل ضلعًا $\sqrt{14}$، لكن الآخر $\sqrt{26}$."
      hint "احسب أولًا الضلع الذي لا يحوي $k$."
      hint "ساوِ كل ضلع فيه $k$ به، وخذ القيمة المشتركة."
      ! "الضلع المعروف $\sqrt{4 + 1 + 9} = \sqrt{14}$. الضلع الأول يعطي $k = 7$ أو $3$، والثاني $k = 7$ أو $1$. المشترك $7$."
    }
  }

  slide "نقطة على محور على بعدين متساويين" {
    id: "sg1-dist-30"
    beat: example
    cat: "البعد بين نقطتين"

    numeric {
      ask "$A(2, -5, 7)$ و $B(1, 3, 6)$، و $C$ نقطة على محور $y$ على بعدين متساويين من $A$ و $B$. ما الإحداثي $y$ للنقطة $C$؟"
      skill: "sg-3d-distance"
      answer: -2
      expect: (0 - 32) / 16
      wrong 2 "انتبه للإشارة: $16k = -32$."
      hint "$C(0, k, 0)$. ساوِ $CA^2$ بـ $CB^2$، والحد $k^2$ يُلغى."
      ! "$4 + (k + 5)^2 + 49 = 1 + (k - 3)^2 + 36$، فـ $16k = -32$ و $C(0, -2, 0)$."
    }
  }

  slide "نقطة على محور على بعد معلوم" {
    id: "sg1-dist-35"
    beat: example
    cat: "البعد بين نقطتين"

    quiz {
      ask "النقطة التي على محور $y$ وتبعد $\sqrt{10}$ وحدة طول عن النقطة $(1, 2, 3)$ هي:"
      skill: "sg-3d-distance"
      - "$(0, -2, 0)$" { why: "بعدها $\sqrt{1 + 16 + 9} = \sqrt{26}$." }
      * "$(0, 2, 0)$"
      - "$(0, 4, 0)$" { why: "بعدها $\sqrt{1 + 4 + 9} = \sqrt{14}$." }
      - "$(0, -4, 0)$" { why: "بعدها $\sqrt{1 + 36 + 9} = \sqrt{46}$." }
      ! "$\sqrt{1 + (c - 2)^2 + 9} = \sqrt{10}$ يعطي $(c - 2)^2 = 0$، أي $c = 2$."
    }
  }

  slide "أي العلاقات صحيحة؟" {
    id: "sg1-dist-31"
    beat: example
    cat: "البعد بين نقطتين"

    quiz {
      ask "$A(3, 4, 8)$ و $B(1, 2, 7)$ و $C(3, 0, 6)$. أي العلاقات صحيحة؟"
      skill: "sg-3d-distance"
      - "$2AB = BC$" { why: "احسب الاثنين: $AB = \sqrt{4 + 4 + 1}$، و $BC$؟" }
      - "$AB = 2BC$" { why: "$BC = \sqrt{4 + 4 + 1}$ أيضًا." }
      * "$AB = BC$"
      - "$3AB = BC$" { why: "الطولان متساويان، فلا مضاعف بينهما." }
      ! "$AB = \sqrt{4 + 4 + 1} = 3$ و $BC = \sqrt{4 + 4 + 1} = 3$، فـ $AB = BC$."
    }
  }

  slide "على استقامة واحدة" {
    id: "sg1-line"
    beat: example
    cat: "البعد بين نقطتين"
    > من أمثلة الكتاب: $A(6, 0, 3)$ و $B(7, 1, 7)$ و $C(9, 3, 15)$. احسب الأطوال الثلاثة، ثم انظر إليها معًا.

    table {
      ask "اكتب كل طول لمنزلتين عشريتين."
      skill: "sg-3d-distance"
      header: ["$AB$", "$BC$", "$AC$"]
      row: blank(3 * sqrt(2)), blank(6 * sqrt(2)), blank(9 * sqrt(2))
      tolerance: 0.01
      hint "$AB = \sqrt{1 + 1 + 16}$."
      ! "$AB = 3\sqrt{2}$ و $BC = 6\sqrt{2}$ و $AC = 9\sqrt{2}$. الطريق عبر $B$ لا يطول شيئًا: $AB + BC = AC$، فالنقاط الثلاث على استقامة واحدة."
    }
  }

  slide "برهن أنها على استقامة واحدة" {
    id: "sg1-line-own"
    beat: example
    cat: "البعد بين نقطتين"

    quiz {
      ask "$A(7, 1, 4)$ و $B(8, 2, 8)$ و $C(10, 4, 16)$. أي علاقة تثبت أنها على استقامة واحدة؟"
      skill: "sg-3d-distance"
      * "$AB + BC = AC$"
      - "$AB^2 + BC^2 = AC^2$" { why: "هذه علاقة الزاوية القائمة في $B$، أي مثلث حقيقي لا خط." }
      - "$AB = BC$" { why: "هذا يعني أن $B$ على بعدين متساويين من $A$ و $C$. وهنا $AB = 3\sqrt{2}$ و $BC = 6\sqrt{2}$." }
      - "$AC > AB + BC$" { why: "هذا مستحيل: الخط المستقيم لا يكون أطول من أي طريق آخر." }
      ! "$AB = 3\sqrt{2}$ و $BC = 6\sqrt{2}$ و $AC = 9\sqrt{2}$. المجموع يطابق، فـ $B$ على القطعة $\overline{AC}$."
    }
  }

  slide "نوع المثلث" {
    id: "sg1-obtuse"
    beat: example
    cat: "البعد بين نقطتين"
    > في المثلث: إذا كان مربع أطول ضلع أكبر من مجموع مربعي الآخرين فالزاوية المقابلة له منفرجة، وإذا ساواه فهي قائمة.

    quiz {
      ask "$A(4, 1, 5)$ و $B(-4, 3, 1)$ و $C(-2, 5, 1)$. المثلث $ABC$:"
      skill: "sg-3d-distance"
      - "قائم الزاوية في $C$" { why: "$(AB)^2 = 84$ و $(AC)^2 + (BC)^2 = 68 + 8 = 76$. غير متساويين." }
      * "منفرج الزاوية في $C$"
      - "حاد الزوايا" { why: "$84 > 76$، فالزاوية المقابلة لـ $AB$ أكبر من القائمة." }
      - "منفرج الزاوية في $A$" { why: "الزاوية المنفرجة تقابل أطول ضلع، وهو $AB$، فهي عند $C$." }
      hint "احسب مربعات الأضلاع الثلاثة، بلا جذور."
      ! "$(AB)^2 = 84$ و $(BC)^2 = 8$ و $(AC)^2 = 68$. $84 > 8 + 68$، فالمثلث منفرج الزاوية في $C$."
    }
  }

  slide "مساحة مثلث قائم" {
    id: "sg1-right"
    beat: example
    cat: "البعد بين نقطتين"

    numeric {
      ask "النقاط $A(2, -1, 3)$ و $B(-4, 4, 2)$ و $C(-2, 5, 1)$ رؤوس مثلث قائم. أوجد مساحته لمنزلتين عشريتين."
      skill: "sg-3d-distance"
      answer: 2 * sqrt(21)
      expect: 0.5 * sqrt(6) * sqrt(56)
      tolerance: 0.01
      unit: "وحدة مربعة"
      wrong 0.5 * sqrt(62) * sqrt(6) "استخدمت الوتر $AB$ كأنه ضلع قائم. الضلعان القائمان هما $AC$ و $BC$."
      wrong sqrt(56) * sqrt(6) "نسيت $\frac{1}{2}$."
      hint "ابدأ بمربعات الأضلاع. أيها يساوي مجموع الآخرين؟"
      ! "$(AB)^2 = 62 = 56 + 6$، فالزاوية القائمة عند $C$. المساحة $\frac{1}{2}\sqrt{56}\sqrt{6} = 2\sqrt{21} \approx 9.17$."
    }
  }

  slide "مساحة مثلث متساوي الأضلاع" {
    id: "sg1-equi"
    beat: example
    cat: "البعد بين نقطتين"

    numeric {
      ask "النقاط $A(1, 2, 5)$ و $B(2, 5, 3)$ و $C(-1, 3, 2)$ رؤوس مثلث متساوي الأضلاع. أوجد مساحته لمنزلتين عشريتين."
      skill: "sg-3d-distance"
      answer: 7 * sqrt(3) / 2
      expect: sqrt(3) / 4 * 14
      tolerance: 0.01
      unit: "وحدة مربعة"
      wrong 14 "هذا مربع الضلع. المساحة $\frac{\sqrt{3}}{4}\ell^2$."
      wrong sqrt(3) / 4 * sqrt(14) "استخدمت الضلع بدل مربعه."
      hint "احسب $\ell^2$ لضلع واحد، ثم $\frac{\sqrt{3}}{4}\ell^2$."
      ! "كل ضلع مربعه $14$، فالمساحة $\frac{\sqrt{3}}{4} \times 14 = \frac{7\sqrt{3}}{2} \approx 6.06$."
    }
  }

  slide "مثلث متساوي الساقين" {
    id: "sg1-iso"
    beat: example
    cat: "البعد بين نقطتين"

    quiz {
      ask "المثلث الذي رؤوسه $A(7, 1, 3)$ و $B(5, 3, 4)$ و $C(3, 5, 3)$ متساوي الساقين. أي ضلعين متساويان؟"
      skill: "sg-3d-distance"
      * "$AB = BC$"
      - "$AB = AC$" { why: "$AC = \sqrt{16 + 16 + 0} = \sqrt{32}$، و $AB = 3$." }
      - "$BC = AC$" { why: "$AC = \sqrt{32}$، و $BC = 3$." }
      - "الأضلاع الثلاثة متساوية" { why: "$AC = \sqrt{32}$ أطول من الآخرين." }
      ! "$AB = \sqrt{4 + 4 + 1} = 3$ و $BC = \sqrt{4 + 4 + 1} = 3$ و $AC = \sqrt{32}$."
    }
  }

  slide "متى يصير متساوي الأضلاع؟" {
    id: "sg1-iso-k"
    beat: example
    cat: "البعد بين نقطتين"
    > المثلث $A(5, 1, 3)$ و $B(7, 3, k)$ و $C(5, 5, 3)$ متساوي الساقين مهما كان $k$، لأن $AB^2 = BC^2 = 8 + (k - 3)^2$.

    numeric {
      ask "ما قيمة $k$ التي تجعله متساوي الأضلاع؟ تُقبل أي من القيمتين، لمنزلتين عشريتين."
      skill: "sg-3d-distance"
      answer: 3 + 2 * sqrt(2)
      answer: 3 - 2 * sqrt(2)
      expect: 3 + sqrt(8)
      tolerance: 0.01
      wrong 3 "مع $k = 3$ يكون $AB = \sqrt{8}$، لكن $AC = 4$."
      hint "احسب $AC$ أولًا، ثم ساوِ $AB^2$ بـ $AC^2$."
      ! "$AC = 4$، فـ $8 + (k - 3)^2 = 16$ و $k = 3 \pm 2\sqrt{2}$، أي تقريبًا $5.83$ أو $0.17$."
    }
  }

  slide "نقطة المنتصف" {
    id: "sg1-mid"
    beat: example
    cat: "نقطة المنتصف"
    > في المستوى، منتصف القطعة متوسط الإحداثيات. هل يصمد ذلك مع إحداثي ثالث؟ جرّب على مثال الكتاب.

    table {
      ask "أوجد منتصف $\overline{AB}$ حيث $A(5, -4, 0)$ و $B(1, 8, 4)$."
      skill: "sg-3d-midpoint"
      header: ["$x$", "$y$", "$z$"]
      row: blank(3), blank(2), blank(2)
      hint "المنتصف في منتصف كل حركة: متوسط كل إحداثيين."
      ! "المنتصف $(3, 2, 2)$. كل إحداثي متوسط: $\left(\frac{x_1 + x_2}{2}, \frac{y_1 + y_2}{2}, \frac{z_1 + z_2}{2}\right)$."
    }
  }

  slide "منتصفان" {
    id: "sg1-mid-3"
    beat: example
    cat: "نقطة المنتصف"

    table {
      ask "أوجد منتصف $\overline{AB}$ في كل صف: (1) $A(1, -3, 2)$ ، $B(4, -1, 4)$ (2) $A(-3, 5, 5)$ ، $B(-6, 4, 8)$"
      skill: "sg-3d-midpoint"
      header: ["$x$", "$y$", "$z$"]
      row: blank(2.5), blank(-2), blank(3)
      row: blank(-4.5), blank(4.5), blank(6.5)
      hint "متوسط كل زوج، والكسور مقبولة بالعشري."
      ! "(1) $(2.5, -2, 3)$ (2) $(-4.5, 4.5, 6.5)$."
    }
  }

  slide "والعكس: الطرف المجهول" {
    id: "sg1-mid-trap"
    beat: trap
    cat: "نقطة المنتصف"
    > والعكس، من أمثلة الكتاب: $C(3, 2, -1)$ منتصف $\overline{AB}$، و $A(4, 3, -1)$. الإغراء هنا أن تأخذ متوسط $A$ و $C$ كالعادة. هل يصح؟

    quiz {
      ask "ما إحداثيات $B$؟"
      skill: "sg-3d-midpoint"
      - "$(3.5, 2.5, -1)$" { why: "هذا متوسط $A$ و $C$، وهو يقع بينهما، في منتصف الطريق إلى المنتصف. $B$ أبعد: بعد $C$ بمسافة تساوي $AC$.", onwrong: "sg1-d-mid", retry }
      * "$(2, 1, -1)$"
      - "$(-1, -1, 0)$" { why: "هذا $C - A$، الحركة من $A$ إلى $C$. أضفها مرة أخرى إلى $C$.", onwrong: "sg1-d-mid", retry }
      - "$(7, 5, -2)$" { why: "هذا $A + C$. المنتصف يعطي $A + B = 2C$، لا $A + C$." }
      hint "$C$ في منتصف الطريق. أين ينتهي الطريق؟"
      ! "من $A$ إلى $C$ نتحرك $(-1, -1, 0)$، و $B$ حركة مماثلة بعد $C$: $B = 2C - A = (2, 1, -1)$. والكتاب يكتبها $\frac{4 + x}{2} = 3$ فـ $x = 2$."
    }
  }

  slide "المنتصف في منتصف الطريق" {
    id: "sg1-d-mid"
    beat: detour
    hidden: true
    cat: "نقطة المنتصف"
    > النقاط الثلاث هنا فيها $z = -1$، فننظر إليها من فوق. اسحب $B$ حتى تنطبق نقطة منتصف $\overline{AB}$ على $C$.

    scene plane {
      alt: "نظرة من فوق: A عند (4, 3) و C عند (3, 2)، ونقطة B تُسحب على الشبكة. نقطة منتصف AB مرسومة وتتحرك مع B."
      x: [-1, 7]
      y: [-1, 5]
      aspect: equal
      grid
      param u = 6 { range: [-1, 7], step: 1 }
      param v = 1 { range: [-1, 5], step: 1 }
      line seg = (4, 3) -> (u, v) { color: dist, width: 3 }
      point A = (4, 3) { color: neutral, label: "A" }
      point C = (3, 2) { color: warning, label: "C" }
      point M = ((4 + u) / 2, (3 + v) / 2) { color: dist, open, label: "منتصف" }
      point B = (u, v) { drag: xy -> (u, v), snap: grid, color: dist, label: "B" }
    }

    goal "اجعل منتصف $\overline{AB}$ ينطبق على $C$" {
      when: u == 2 and v == 1
      hints: ["المنتصف يتحرك نصف ما تتحركه $B$.", "$B$ بعد $C$ بقدر ما تقع $A$ قبلها."]
      showme: { u: 2, v: 1 }
    }

    numeric {
      ask "$C(1, 0, 2)$ منتصف $\overline{AB}$ و $A(3, 4, 1)$. ما الإحداثي $x$ للنقطة $B$؟"
      skill: "sg-3d-midpoint"
      answer: -1
      expect: 2 * 1 - 3
      wrong 2 "هذا متوسط $A$ و $C$. $B$ أبعد من $C$، لا بينها وبين $A$."
      after: goals
      ! "$B = 2C - A$: $2 \times 1 - 3 = -1$."
    }
  }

  slide "تمرين: الطرف الآخر" {
    id: "sg1-mid-12e"
    beat: example
    cat: "نقطة المنتصف"

    table {
      ask "$C(-1, 4, 0)$ منتصف القطعة $\overline{AB}$ حيث $B(4, -2, 1)$. أوجد $A$."
      skill: "sg-3d-midpoint"
      header: ["$x$", "$y$", "$z$"]
      row: blank(-6), blank(10), blank(-1)
      hint "$A = 2C - B$."
      ! "$A = (-2 - 4, 8 + 2, 0 - 1) = (-6, 10, -1)$."
    }
  }

  slide "تمرين: اختر النقطة" {
    id: "sg1-mid-19"
    beat: example
    cat: "نقطة المنتصف"

    quiz {
      ask "$(5, 6, -3)$ هي منتصف $\overline{AB}$ حيث $A(3, -1, 5)$. إذن $B$ ="
      skill: "sg-3d-midpoint"
      - "$(4, \frac{5}{2}, 1)$" { why: "هذا متوسط $A$ والمنتصف، وهو بينهما. $B$ بعد المنتصف.", onwrong: "sg1-d-mid", retry }
      * "$(7, 13, -11)$"
      - "$(-2, -7, 8)$" { why: "هذا $A$ ناقص المنتصف. المطلوب $2 \times$ المنتصف $- A$." }
      - "$(3, 2, 13)$" { why: "عوّض: منتصف $A$ وهذه النقطة $(3, \frac{1}{2}, 9)$، لا $(5, 6, -3)$." }
      ! "$B = 2(5, 6, -3) - (3, -1, 5) = (7, 13, -11)$."
    }
  }

  slide "تمرين: منتصف فيه كسر" {
    id: "sg1-mid-11"
    beat: example
    cat: "نقطة المنتصف"

    quiz {
      ask "نقطة منتصف القطعة $\overline{DE}$ حيث $D(2, 3, 3)$ و $E(6, -1, -4)$ هي:"
      skill: "sg-3d-midpoint"
      - "$(4, 2, 3\frac{1}{2})$" { why: "هذا بطرح الإحداثيات السالبة بدل جمعها: $\frac{3 + (-1)}{2} = 1$." }
      - "$(2, 1, \frac{1}{2})$" { why: "هذا نصف الفرق، أي نصف الحركة من $D$ إلى $E$، لا المنتصف." }
      * "$(4, 1, -\frac{1}{2})$"
      - "$(4, 1, \frac{1}{2})$" { why: "انتبه للإشارة: $\frac{3 + (-4)}{2} = -\frac{1}{2}$." }
      ! "$\left(\frac{2 + 6}{2}, \frac{3 - 1}{2}, \frac{3 - 4}{2}\right) = (4, 1, -\frac{1}{2})$."
    }
  }

  slide "تمرين: مجموع الإحداثيات" {
    id: "sg1-mid-12"
    beat: example
    cat: "نقطة المنتصف"

    numeric {
      ask "$(a, b, c)$ منتصف $\overline{DE}$ حيث $D(-4, 0, 5)$ و $E(-2, 4, -13)$. ما $a + b + c$؟"
      skill: "sg-3d-midpoint"
      answer: -5
      expect: (-4 - 2) / 2 + (0 + 4) / 2 + (5 - 13) / 2
      wrong -10 "جمعت الإحداثيات ولم تقسم على $2$."
      hint "أوجد المنتصف أولًا، ثم اجمع إحداثياته."
      ! "المنتصف $(-3, 2, -4)$، والمجموع $-5$."
    }
  }

  slide "تمرين: المتغير يختفي" {
    id: "sg1-mid-13"
    beat: breaker
    cat: "نقطة المنتصف"

    quiz {
      ask "$A(2m - 1, 3m, 2m + 1)$ و $B(3 - 2m, 4 - 3m, 5 - 2m)$. نقطة منتصف $\overline{AB}$ هي:"
      skill: "sg-3d-midpoint"
      - "$(1, 3, 6)$" { why: "افحص $y$: $\frac{3m + 4 - 3m}{2} = 2$." }
      * "$(1, 2, 3)$"
      - "$(5, 4, 3)$" { why: "افحص $x$: $\frac{2m - 1 + 3 - 2m}{2} = 1$." }
      - "$(1, 4, 6)$" { why: "هذه المجاميع $2$ و $4$ و $6$ بعد قسمة الأول فقط. اقسم الثلاثة على $2$." }
      hint "لا تبحث عن $m$. اجمع الإحداثيين وانظر ماذا يحدث."
      ! "الجمع يلغي $m$ في كل إحداثي: $\frac{2}{2}$ و $\frac{4}{2}$ و $\frac{6}{2}$، فالمنتصف $(1, 2, 3)$ مهما كانت $m$."
    }
  }

  slide "تمرين: منتصف في مستوى" {
    id: "sg1-mid-14"
    beat: example
    cat: "نقطة المنتصف"

    quiz {
      ask "نقطة منتصف $\overline{AB}$ تقع في المستوى الإحداثي $xz$، حيث $A(-3, 12 + k, 5)$ و $B(1, 3k, -2)$. إذن $k$ ="
      skill: "sg-3d-midpoint"
      - "$5$" { why: "عوّض: $12 + 5 + 15 = 32$، لا صفر." }
      * "$-3$"
      - "$-2$" { why: "عوّض: $12 - 2 - 6 = 4$، لا صفر." }
      - "$1$" { why: "عوّض: $12 + 1 + 3 = 16$، لا صفر." }
      hint "في $xz$ يكون $y = 0$. ما الإحداثي $y$ للمنتصف؟"
      ! "$\frac{12 + k + 3k}{2} = 0$، فـ $4k = -12$ و $k = -3$."
    }
  }

  slide "تمرين: منتصف على محور" {
    id: "sg1-mid-26"
    beat: example
    cat: "نقطة المنتصف"

    numeric {
      ask "منتصف $\overline{AB}$ يقع على محور $x$، حيث $A(2, 12 + k, k)$ و $B(4, m, 8 - m)$. ما $k - 3m$؟"
      skill: "sg-3d-midpoint"
      answer: -4
      expect: (0 - 10) - 3 * (0 - 2)
      wrong -16 "انتبه للإشارة: $m = -2$، فـ $-3m = +6$."
      hint "على محور $x$: $y = 0$ و $z = 0$ للمنتصف. معادلتان."
      ! "$12 + k + m = 0$ و $k + 8 - m = 0$، فـ $k = -10$ و $m = -2$، و $k - 3m = -10 + 6 = -4$."
    }
  }

  slide "تمرين: طول متوسط" {
    id: "sg1-mid-37"
    beat: example
    cat: "نقطة المنتصف"

    quiz {
      ask "$ABC$ مثلث فيه $D$ منتصف $\overline{BC}$، و $A(3, 1, 5)$ و $B(2, 3, 7)$ و $C(0, 3, 1)$. طول $AD$ = … وحدة طول."
      skill: "sg-3d-midpoint"
      - "$9$" { why: "$9$ هو $AD^2$. بقي الجذر." }
      - "$2$" { why: "احسب $D$ أولًا: $(1, 3, 4)$. ثم البعد من $A$." }
      - "$7$" { why: "$D = (1, 3, 4)$، والفروق $2$ و $-2$ و $1$." }
      * "$3$"
      ! "$D = (1, 3, 4)$، و $AD = \sqrt{4 + 4 + 1} = 3$."
    }
  }

  slide "تمرين: ثلاثة مجاهيل" {
    id: "sg1-mid-13e"
    beat: example
    cat: "نقطة المنتصف"

    numeric {
      ask "$C(-1, 6, -5)$ منتصف $\overline{AB}$ حيث $A(k - 2, -1, m + 3)$ و $B(2, n - 7, -2)$. أوجد $k + m - n$."
      skill: "sg-3d-midpoint"
      answer: -33
      expect: (0 - 2) + (0 - 11) - 20
      wrong -13 "$n = 20$ لا $0$: $-1 + n - 7 = 12$."
      hint "إحداثي واحد لكل مجهول: $\frac{k - 2 + 2}{2} = -1$، وهكذا."
      ! "$k = -2$ و $n = 20$ و $m = -11$، فـ $k + m - n = -33$."
    }
  }

  slide "تمرين: مثلث المنتصفات" {
    id: "sg1-mid-14e"
    beat: example
    cat: "نقطة المنتصف"

    numeric {
      ask "أوجد محيط المثلث الناتج من توصيل منتصفات أضلاع المثلث $ABC$ حيث $A(2, 5, -1)$ و $B(6, -3, 3)$ و $C(-4, 7, 1)$، لمنزلة عشرية واحدة."
      skill: "sg-3d-midpoint"
      answer: (sqrt(96) + sqrt(204) + sqrt(44)) / 2
      expect: (sqrt(4^2 + 8^2 + 4^2) + sqrt(10^2 + 10^2 + 2^2) + sqrt(6^2 + 2^2 + 2^2)) / 2
      tolerance: 0.05
      unit: "وحدة طول"
      wrong sqrt(96) + sqrt(204) + sqrt(44) "هذا محيط $ABC$ نفسه. كل ضلع في مثلث المنتصفات نصف ضلع يوازيه."
      hint "القطعة الواصلة بين منتصفي ضلعين تساوي نصف الضلع الثالث."
      ! "$AB + BC + AC = \sqrt{96} + \sqrt{204} + \sqrt{44} \approx 30.7$، ومثلث المنتصفات محيطه النصف: $\approx 15.4$."
    }
  }

  slide "تمرين: رؤوس على المحاور" {
    id: "sg1-mid-15e"
    beat: example
    cat: "نقطة المنتصف"

    table {
      ask "$A$ على محور $x$ و $B$ على محور $y$ و $C$ على محور $z$. $(1, -1, 0)$ منتصف $\overline{AB}$، و $(0, -1, 2)$ منتصف $\overline{BC}$. أوجد منتصف $\overline{AC}$."
      skill: "sg-3d-midpoint"
      header: ["$x$", "$y$", "$z$"]
      row: blank(1), blank(0), blank(2)
      hint "$A(l, 0, 0)$ و $B(0, m, 0)$ و $C(0, 0, n)$. منتصف $\overline{AB}$ هو $(\frac{l}{2}, \frac{m}{2}, 0)$."
      ! "$l = 2$ و $m = -2$ و $n = 4$، فمنتصف $\overline{AC}$ هو $(1, 0, 2)$."
    }
  }

  slide "تمرين: الرؤوس من المنتصفات" {
    id: "sg1-mid-17e"
    beat: example
    cat: "نقطة المنتصف"

    table {
      ask "$D(1, 2, 6)$ و $E(0, 3, 2)$ و $F(2, 0, -2)$ منتصفات $\overline{AB}$ و $\overline{BC}$ و $\overline{AC}$ بالترتيب. أوجد $A$ ثم $B$ ثم $C$، صفًّا لكل رأس."
      skill: "sg-3d-midpoint"
      header: ["$x$", "$y$", "$z$"]
      row: blank(3), blank(-1), blank(2)
      row: blank(-1), blank(5), blank(10)
      row: blank(1), blank(1), blank(-6)
      hint "$D + F - E$ يعطي $A$: جرّبها على الإحداثي $x$."
      ! "$A = D + F - E = (3, -1, 2)$، و $B = D + E - F = (-1, 5, 10)$، و $C = E + F - D = (1, 1, -6)$."
    }
  }

  slide "الرأس الرابع" {
    id: "sg1-transfer-para"
    beat: transfer
    cat: "جرّب في مكان جديد"
    > أسئلة في أماكن جديدة، بلا مساعدة.

    table {
      ask "$A(6, -2, 4)$ و $B(2, 4, -8)$ و $C(-2, 2, 4)$ ثلاثة رؤوس متتالية لمتوازي الأضلاع $ABCD$. أوجد $D$."
      skill: "sg-3d-midpoint"
      header: ["$x$", "$y$", "$z$"]
      row: blank(2), blank(-4), blank(16)
      ! "قطرا متوازي الأضلاع ينصّف كل منهما الآخر: منتصف $\overline{AC}$ هو $(2, 0, 4)$، فـ $D = 2(2, 0, 4) - B = (2, -4, 16)$."
    }
  }

  slide "مثلث لا تعرف رؤوسه" {
    id: "sg1-transfer-tri"
    beat: transfer
    cat: "جرّب في مكان جديد"

    numeric {
      ask "$M(1, 2, 3)$ و $N(4, 2, 3)$ و $H(1, 6, 3)$ منتصفات $\overline{AB}$ و $\overline{BC}$ و $\overline{CA}$ بالترتيب. كم محيط المثلث $ABC$؟"
      skill: "sg-3d-distance"
      answer: 24
      expect: 2 * (3 + 4 + sqrt(3^2 + 4^2))
      unit: "وحدة طول"
      wrong 12 "هذا محيط مثلث المنتصفات. كل ضلع في $ABC$ ضعف الضلع الذي يوازيه."
      ! "$MN = 3$ و $MH = 4$ و $NH = 5$، فمحيط مثلث المنتصفات $12$، ومحيط $ABC$ ضعفه: $24$. ستعود هذه الأفكار في التمرين خلال الأيام القادمة، مختلطة ببقية الوحدة."
    }
  }

  slide "انعكاس في محور" {
    id: "sg1-transfer-refl"
    beat: transfer
    cat: "جرّب في مكان جديد"

    quiz {
      ask "صورة النقطة $(-2, 3, 4)$ بالانعكاس في محور $z$ هي:"
      skill: "sg-3d-points"
      - "$(-2, 3, 4)$" { why: "هذه النقطة نفسها. الانعكاس ينقلها إلى الجهة الأخرى من المحور." }
      - "$(2, 3, 4)$" { why: "هذا انعكاس في الجدار $yz$: قلب $x$ وحده." }
      - "$(2, -3, -4)$" { why: "هذا قلب الإحداثيات كلها تقريبًا. محور $z$ لا يغيّر الارتفاع." }
      * "$(2, -3, 4)$"
      ! "الدوران حول محور $z$ نصف دورة يبقي الارتفاع ويقلب $x$ و $y$: $(2, -3, 4)$. والبعد عن المحور $\sqrt{4 + 9}$ لم يتغير."
    }
  }

  slide "نقطة على بعد واحد من أربع" {
    id: "sg1-transfer-eq"
    beat: transfer
    cat: "جرّب في مكان جديد"

    quiz {
      ask "النقطة $E$ على أبعاد متساوية من النقاط $O(0, 0, 0)$ و $A(l, 0, 0)$ و $B(0, m, 0)$ و $C(0, 0, n)$. إذن $E$ ="
      skill: "sg-3d-distance"
      - "$(l, m, n)$" { why: "بعدها عن $A$ هو $\sqrt{m^2 + n^2}$، وعن $O$ أكبر: $\sqrt{l^2 + m^2 + n^2}$." }
      - "$(-\frac{l}{2}, -\frac{m}{2}, -\frac{n}{2})$" { why: "هذه على بعد متساوٍ من $O$ فقط وصورها. بعدها عن $A$ أكبر من بعدها عن $O$." }
      - "$(-l, -m, -n)$" { why: "بعدها عن $A$: $\sqrt{4l^2 + m^2 + n^2}$، أكبر من بعدها عن $O$." }
      * "$(\frac{l}{2}, \frac{m}{2}, \frac{n}{2})$"
      ! "التساوي مع $O$ و $A$ يضع $x$ في منتصف $0$ و $l$، أي $\frac{l}{2}$. وبالمثل $\frac{m}{2}$ و $\frac{n}{2}$."
    }
  }
}
