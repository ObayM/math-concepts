lesson "Curve Sketching" {
  course: "calculus"
  unit: "Applications of the Derivative"
  difficulty: "Advanced"
  icon: "FunctionSquare"
  summary: "Combine critical points, concavity, and everything else from this unit into one complete sketching workflow."
  skills: ["appderiv-curve-sketching"]

  slide "The Complete Recipe" {
    id: "ad5-intro"
    cat: "The Recipe"
    > Every tool from this unit combines into one workflow for sketching a
    > function by hand: find where it lives (domain, intercepts, asymptotes),
    > then use $f'$ to find where it climbs and falls, then use $f''$ to find
    > where it bends. Put all of that together and the shape draws itself.
  }

  slide "A Worked Example" {
    id: "ad5-worked"
    cat: "The Recipe"
    > Take $f(x) = x^{3} - 3x^{2}$. Differentiating: $f'(x) = 3x^{2} - 6x =
    > 3x(x-2)$, so the critical points are $x = 0$ and $x = 2$. Differentiating
    > again: $f''(x) = 6x - 6$, zero at $x = 1$.
    >
    > Checking signs around each critical point places a local max at $x = 0$
    > and a local min at $x = 2$, with an inflection point at $x = 1$ sitting
    > right between them.

    scene plane {
      x: [-2, 4]
      y: [-6, 4]
      grid
      axes
      curve f = x^3 - 3 * x^2 { color: primary, width: 3 }
      point maxP = (0, 0) { color: success, r: 7, label: "local max" }
      point minP = (2, -4) { color: danger, r: 7, label: "local min" }
      point infP = (1, -2) { color: accent, r: 6, label: "inflection" }
    }
  }

  slide "Classify x = 0" {
    id: "ad5-quiz-classify0"
    cat: "The Recipe"
    quiz {
      ask "For $f(x) = x^{3} - 3x^{2}$: f'(-1) = 9 and f'(1) = -3. What is x = 0?"
      skill: "appderiv-curve-sketching"
      * "A local maximum"
      - "A local minimum" { why: "The sign goes from positive to negative here, the local max pattern." }
      - "Neither" { why: "The sign does change, so this is a genuine local extremum." }
      - "An inflection point" { why: "Inflection points come from f'' changing sign, not f'." }
      hint "f' goes from positive (before 0) to negative (after 0)."
      ! "f' switches from + to - at x = 0, so it's a local maximum, matching the first derivative test."
    }
  }

  slide "Classify x = 2" {
    id: "ad5-quiz-classify2"
    cat: "The Recipe"
    quiz {
      ask "For $f(x) = x^{3} - 3x^{2}$: f'(1) = -3 and f'(3) = 9. What is x = 2?"
      skill: "appderiv-curve-sketching"
      - "A local maximum" { why: "That's the + to - pattern, but here the sign goes the other way." }
      * "A local minimum"
      - "Neither" { why: "The sign does change, so this is a genuine local extremum." }
      - "An inflection point" { why: "Inflection points come from f'' changing sign, not f'." }
      hint "f' goes from negative (before 2) to positive (after 2)."
      ! "f' switches from - to + at x = 2, so it's a local minimum, matching the first derivative test."
    }
  }

  slide "Find the Inflection Point" {
    id: "ad5-numeric-inflection"
    cat: "The Recipe"
    numeric {
      ask "For $f(x) = x^{3} - 3x^{2}$, find the x-coordinate of the inflection point."
      skill: "appderiv-curve-sketching"
      answer: 1
      hint "Set f''(x) = 6x - 6 equal to 0."
      ! "6x - 6 = 0 gives x = 1."
    }
  }

  slide "Evaluate at the Inflection Point" {
    id: "ad5-numeric-value"
    cat: "The Recipe"
    numeric {
      ask "Find $f(1)$ for $f(x) = x^{3} - 3x^{2}$."
      skill: "appderiv-curve-sketching"
      answer: -2
      hint "Plug x = 1 directly into f."
      ! "f(1) = 1 - 3 = -2, matching the inflection point marked on the graph."
    }
  }

  slide "Order the Steps" {
    id: "ad5-order"
    cat: "The Recipe"
    order {
      ask "Put the curve-sketching steps in order."
      skill: "appderiv-curve-sketching"
      item "Find the domain, intercepts, and any asymptotes"
      item "Find critical points using f'"
      item "Classify each critical point with the first or second derivative test"
      item "Find inflection points using f''"
      item "Combine everything into a sketch"
      decoy "Guess the shape without computing anything"
      ! "Structure first (domain, intercepts, asymptotes), then f' for shape, then f'' for bending, then draw."
    }
  }
}
